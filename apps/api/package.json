{
  "name": "@miniapp/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "node --env-file=.env ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:gallery": "node --env-file=.env scripts/seed-gallery.mjs",
    "seed:gallery:check": "node --env-file=.env scripts/seed-gallery.mjs --dry-run",
    "smoke:auth": "node --env-file=.env scripts/auth-runtime-smoke.mjs",
    "smoke:availability": "node --env-file=.env scripts/availability-runtime-smoke.mjs",
    "smoke:booking-rules": "node --env-file=.env scripts/booking-rules-gallery-smoke.mjs",
    "smoke:gallery": "node --env-file=.env scripts/gallery-runtime-smoke.mjs",
    "smoke:my-inspirations": "node --env-file=.env scripts/my-inspirations-runtime-smoke.mjs",
    "smoke:create-appointment": "node --env-file=.env scripts/create-appointment-runtime-smoke.mjs",
    "smoke:parallel": "node --env-file=.env scripts/smoke-parallel-run.cjs",
    "smoke:staff-race": "node --env-file=.env scripts/staff-appointment-race-smoke.mjs",
    "test": "npm run smoke:auth && npm run smoke:availability && npm run smoke:booking-rules && npm run smoke:gallery && npm run smoke:my-inspirations && npm run smoke:create-appointment && npm run smoke:parallel && npm run smoke:staff-race"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.2",
    "@nestjs/core": "^10.4.2",
    "@nestjs/platform-express": "^10.4.2",
    "@prisma/client": "^5.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@types/node": "^22.13.10",
    "prisma": "^5.20.0",
    "typescript": "^5.6.3"
  }
}
