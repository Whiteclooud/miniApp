generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
}

enum UserSystemRole {
  USER
  SYSTEM_ADMIN
}

enum StaffRole {
  STAFF
  OWNER
}

enum StaffMemberStatus {
  ACTIVE
  DISABLED
}

enum StaffInvitationStatus {
  PENDING
  REDEEMED
  REVOKED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum GalleryStatus {
  ACTIVE
  INACTIVE
}

model User {
  id              String         @id @default(cuid())
  openId          String         @unique @map("open_id") @db.VarChar(191)
  role            UserRole
  systemRole      UserSystemRole @default(USER) @map("system_role")
  displayName     String?        @map("display_name") @db.VarChar(191)
  phone           String?        @db.VarChar(32)
  status          UserStatus     @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  staffMembership StaffMember?

  @@map("users")
}

model StaffMember {
  id               String            @id @default(cuid())
  userId           String            @unique @map("user_id") @db.VarChar(191)
  role             StaffRole
  status           StaffMemberStatus @default(ACTIVE)
  createdByUserId  String?           @map("created_by_user_id") @db.VarChar(191)
  disabledByUserId String?           @map("disabled_by_user_id") @db.VarChar(191)
  disabledAt       DateTime?         @map("disabled_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_staff_members_user")

  @@index([role, status], map: "idx_staff_members_role_status")
  @@map("staff_members")
}

model StaffInvitation {
  id               String                @id @default(cuid())
  codeHash         String                @unique @map("code_hash") @db.VarChar(64)
  role             StaffRole
  status           StaffInvitationStatus @default(PENDING)
  expiresAt        DateTime              @map("expires_at")
  createdByUserId  String                @map("created_by_user_id") @db.VarChar(191)
  redeemedByUserId String?               @map("redeemed_by_user_id") @db.VarChar(191)
  redeemedAt       DateTime?             @map("redeemed_at")
  revokedAt        DateTime?             @map("revoked_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  @@index([status, expiresAt], map: "idx_staff_invitations_status_expires_at")
  @@index([createdByUserId, createdAt], map: "idx_staff_invitations_creator_created_at")
  @@map("staff_invitations")
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash") @db.VarChar(191)
  userId    String   @map("user_id") @db.VarChar(191)
  openId    String   @map("open_id") @db.VarChar(191)
  role      UserRole
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId], map: "idx_auth_sessions_user_id")
  @@index([openId], map: "idx_auth_sessions_open_id")
  @@index([expiresAt], map: "idx_auth_sessions_expires_at")
  @@map("auth_sessions")
}

model Appointment {
  id               String             @id @default(cuid())
  customerOpenId   String             @map("customer_open_id") @db.VarChar(191)
  customerName     String?            @map("customer_name") @db.VarChar(191)
  phone            String?            @db.VarChar(32)
  date             String             @db.VarChar(10)
  timeSlot         String             @map("time_slot") @db.VarChar(32)
  approvedSlotKey  String?            @unique @map("approved_slot_key") @db.VarChar(64)
  note             String?            @db.Text
  referenceImageUrlsJson String       @default("[]") @map("reference_image_urls_json") @db.LongText
  status           AppointmentStatus  @default(PENDING)
  createdAt        DateTime           @default(now()) @map("created_at")
  reviewedAt       DateTime?          @map("reviewed_at")
  reviewedByOpenId String?            @map("reviewed_by_open_id") @db.VarChar(191)
  reviewNote       String?            @map("review_note") @db.Text
  cancelledAt      DateTime?          @map("cancelled_at")
  cancelledByOpenId String?           @map("cancelled_by_open_id") @db.VarChar(191)
  cancelReason     String?            @map("cancel_reason") @db.Text

  @@index([customerOpenId], map: "idx_appointments_customer_open_id")
  @@index([date], map: "idx_appointments_date")
  @@index([status], map: "idx_appointments_status")
  @@map("appointments")
}

model AppointmentAuditLog {
  id             String             @id @default(cuid())
  appointmentId  String             @map("appointment_id") @db.VarChar(191)
  actorOpenId    String?            @map("actor_open_id") @db.VarChar(191)
  actorRole      String             @map("actor_role") @db.VarChar(32)
  action         String             @db.VarChar(64)
  fromStatus     AppointmentStatus? @map("from_status")
  toStatus       AppointmentStatus? @map("to_status")
  fromDate       String?            @map("from_date") @db.VarChar(10)
  toDate         String?            @map("to_date") @db.VarChar(10)
  fromTimeSlot   String?            @map("from_time_slot") @db.VarChar(32)
  toTimeSlot     String?            @map("to_time_slot") @db.VarChar(32)
  note           String?            @db.Text
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([appointmentId, createdAt], map: "idx_appointment_audit_logs_appointment_id_created_at")
  @@map("appointment_audit_logs")
}

model BookingRule {
  id                    String   @id @default(cuid())
  advanceOpenDays       Int      @default(7) @map("advance_open_days")
  closedDatesJson       String   @default("[]") @map("closed_dates_json") @db.LongText
  dailySlotsJson        String   @default("[]") @map("daily_slots_json") @db.LongText
  weeklyOpenDaysJson    String   @map("weekly_open_days_json") @db.LongText
  sameDayCutoffTime     String?  @map("same_day_cutoff_time") @db.VarChar(5)
  minAdvanceHours       Int      @default(0) @map("min_advance_hours")
  dateSlotOverridesJson String   @map("date_slot_overrides_json") @db.LongText
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("booking_rules")
}

model GalleryItem {
  id              String        @id @default(cuid())
  title           String        @db.VarChar(191)
  imageUrl        String        @map("image_url") @db.Text
  imageUrlsJson   String        @default("[]") @map("image_urls_json") @db.LongText
  description     String?       @db.Text
  tagsJson        String        @default("[]") @map("tags_json") @db.LongText
  publishedAt     DateTime      @default(now()) @map("published_at")
  createdByOpenId String?       @map("created_by_open_id") @db.VarChar(191)
  sortOrder       Int           @default(0) @map("sort_order")
  status          GalleryStatus @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  customerInspirations CustomerInspiration[]

  @@index([publishedAt], map: "idx_gallery_items_published_at")
  @@index([sortOrder], map: "idx_gallery_items_sort_order")
  @@index([status], map: "idx_gallery_items_status")
  @@map("gallery_items")
}

model CustomerInspiration {
  id             String      @id @default(cuid())
  customerOpenId String      @map("customer_open_id") @db.VarChar(191)
  galleryItemId  String      @map("gallery_item_id") @db.VarChar(191)
  note           String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  galleryItem    GalleryItem @relation(fields: [galleryItemId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_customer_inspirations_gallery_item")

  @@unique([customerOpenId, galleryItemId], map: "uq_customer_inspirations_owner_gallery")
  @@index([customerOpenId, createdAt], map: "idx_customer_inspirations_owner_created_at")
  @@index([galleryItemId], map: "idx_customer_inspirations_gallery_item_id")
  @@map("customer_inspirations")
}
