<view class="container">
  <view class="hero-card card">
    <view class="eyebrow">单店预约 · 审批制</view>
    <view class="hero-title">把喜欢的款式，提前预约下来</view>
    <view class="hero-subtitle">
      查看返图灵感、选择可预约日期与时间段，提交后由店员审核确认。
    </view>
    <view class="hero-actions">
      <button class="button-primary hero-button" bindtap="goBooking">立即预约</button>
      <button class="button-secondary hero-button secondary" bindtap="goMyBookings">查看我的预约</button>
    </view>
  </view>

  <view class="card api-profile-card">
    <view class="api-profile-label">当前接口基线</view>
    <view class="api-profile-title">{{apiProfileLabel}}</view>
    <view class="api-profile-url">Base URL：{{apiProfileBaseUrl}}</view>
  </view>

  <view wx:if="{{canSwitchApiProfile}}" class="card api-switch-card">
    <view class="api-profile-label">开发环境切流开关</view>
    <view class="api-switch-desc">默认仍使用 apps/server；只有你显式切换时，才会把当前设备流量导向 apps/api。</view>
    <view class="api-switch-actions">
      <button class="button-secondary switch-button" bindtap="switchToApiProfile" loading="{{switchingApiProfile}}" disabled="{{switchingApiProfile || apiProfileKey === 'api'}}">切到 apps/api</button>
      <button class="button-secondary switch-button" bindtap="switchToLegacyProfile" loading="{{switchingApiProfile}}" disabled="{{switchingApiProfile || apiProfileKey === 'legacy'}}">使用 apps/server</button>
      <button class="button-plain switch-link" bindtap="resetApiProfile" disabled="{{switchingApiProfile}}">恢复默认基线</button>
    </view>
  </view>

  <view class="section-header">
    <view class="section-title">返图灵感</view>
    <view class="section-subtitle">首页只展示封面图，点击卡片可查看详情多图</view>
  </view>

  <view wx:if="{{loading}}" class="card state-card">正在加载返图内容...</view>
  <view wx:elif="{{hasError}}" class="card state-card">返图内容暂时不可用，你也可以先直接去预约。</view>
  <view wx:elif="{{galleryItems.length === 0}}" class="card state-card">返图内容整理中，稍后再来看看。</view>
  <block wx:else>
    <block wx:for="{{galleryItems}}" wx:key="id">
      <view class="card gallery-card" data-id="{{item.id}}" bindtap="goGalleryDetail">
        <image
          wx:if="{{item.imageUrl}}"
          class="gallery-image"
          mode="aspectFill"
          src="{{item.imageUrl}}"
        />
        <view class="gallery-body">
          <view class="gallery-title">{{item.title}}</view>
          <view class="gallery-tags">
            <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
          </view>
          <view class="gallery-desc">点击查看详情多图</view>
        </view>
      </view>
    </block>
  </block>

  <view class="note-card card">
    <view class="note-title">预约说明</view>
    <view class="note-text">当前为提交申请模式，预约提交后需等待店员审核通过。</view>
    <button class="button-plain staff-entry" bindtap="goStaffRules">店员入口</button>
  </view>
</view>
