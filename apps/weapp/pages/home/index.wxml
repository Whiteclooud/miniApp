<view class="container home-page">
  <view wx:if="{{showAuthCard}}" class="card auth-card">
    <view class="auth-header">
      <view>
        <view class="auth-title">微信登录</view>
        <view class="auth-subtitle">{{isLoggedIn ? (phoneBound ? '已完成手机号绑定' : '登录成功，可按需绑定手机号') : '登录后即可管理预约和灵感'}}</view>
      </view>
      <button wx:if="{{isLoggedIn}}" class="button-plain auth-logout" bindtap="logout">退出登录</button>
    </view>

    <view wx:if="{{!isLoggedIn || !phoneBound}}" class="auth-consent">
      <view wx:if="{{authMessage}}" class="auth-error">{{authMessage}}</view>
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-label">
          <checkbox value="service" checked="{{agreementChecked}}" color="#e8856c" />
          <text>我已阅读并同意《服务协议》</text>
        </label>
      </checkbox-group>
      <button
        class="button-primary auth-button"
        open-type="getPhoneNumber"
        disabled="{{!agreementChecked || phoneLoginLoading}}"
        bindgetphonenumber="handlePhoneLogin"
      >{{phoneLoginLoading ? '正在授权…' : '手机号授权登录'}}</button>
      <button class="button-secondary auth-button auth-secondary-button" bindtap="loginWithoutPhone">使用微信登录（不授权手机号）</button>
    </view>

    <view wx:if="{{isLoggedIn && phoneBound}}" class="auth-account">当前微信账号已登录</view>
  </view>

  <view class="hero-card card">
    <view class="eyebrow">单店预约 · 审批制</view>
    <view class="hero-title">
      <view>把喜欢的款式，</view>
      <view>提前预约下来</view>
    </view>
    <view class="hero-subtitle">查看返图灵感、选择可预约日期与时间段，提交后由店员审核确认。</view>
    <view class="hero-actions">
      <button class="button-primary hero-button" bindtap="goBooking">立即预约</button>
      <button class="button-secondary hero-button secondary" bindtap="goMyBookings">查看我的预约</button>
    </view>
  </view>

  <view class="section-header section-header-inline">
    <view class="section-heading-copy">
      <view class="section-title">返图灵感</view>
      <view class="section-subtitle">最近发布的款式，点击卡片查看详情多图</view>
    </view>
    <button class="button-plain view-all-button" bindtap="goGalleryList">查看全部 ›</button>
  </view>

  <view wx:if="{{loading}}" class="card state-card">
    <view class="state-symbol">⌛</view>
    <view class="state-title">返图加载中</view>
    <view class="state-desc">正在读取最新返图</view>
  </view>
  <view wx:elif="{{hasError}}" class="card state-card state-card-error">
    <view class="state-symbol">⚠</view>
    <view class="state-title">加载失败</view>
    <view class="state-desc">{{errorMessage || '返图内容暂时不可用，你也可以先直接去预约。'}}</view>
    <button class="button-secondary state-button" bindtap="retryLaunch">重新检查</button>
  </view>
  <view wx:elif="{{galleryItems.length === 0}}" class="card state-card">
    <view class="state-symbol">⌁</view>
    <view class="state-title">暂无返图</view>
    <view class="state-desc">内容整理中，请稍后</view>
  </view>
  <view wx:else class="gallery-grid">
    <view wx:for="{{galleryItems}}" wx:key="id" class="card gallery-card" data-id="{{item.id}}" bindtap="goGalleryDetail">
      <image wx:if="{{item.imageUrl}}" class="gallery-image" mode="aspectFill" src="{{item.imageUrl}}" />
      <view wx:else class="gallery-image gallery-image-placeholder"></view>
      <view class="gallery-body">
        <view class="gallery-meta-row">
          <view class="gallery-title">{{item.title}}</view>
          <view wx:if="{{item.publishedAtText}}" class="gallery-time">{{item.publishedAtText}}</view>
        </view>
        <view wx:if="{{item.tags.length}}" class="gallery-tags">
          <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
        </view>
        <view class="gallery-desc">{{item.description || '点击查看详情多图'}}</view>
      </view>
    </view>
  </view>

  <view class="note-card card">
    <view class="note-title">预约说明</view>
    <view class="note-text">当前为提交申请模式，预约提交后需等待店员审核通过。</view>
    <button class="button-plain staff-entry" bindtap="goMyInspirations">查看我的灵感</button>
    <button wx:if="{{showStaffEntry}}" class="button-plain staff-entry" bindtap="goStaffRules">店员入口</button>
  </view>
</view>
