@import '../../app.wxss';

.inspirations-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #fffaf8;
}

.inspirations-page button::after {
  border: 0;
}

.identity-card,
.dev-card {
  margin-bottom: 24rpx;
}

.identity-label {
  color: #6b5555;
  font-size: 26rpx;
  line-height: 34rpx;
}

.identity-value {
  margin-top: 10rpx;
  color: #3d2c2c;
  font-size: 26rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.helper-text {
  margin-top: 8rpx;
  color: #a08578;
  font-size: 22rpx;
  line-height: 32rpx;
}

.dev-card {
  border: 2rpx solid #fff0eb;
  background: #fff8f5;
  box-shadow: none;
}

.dev-input,
.note-input {
  box-sizing: border-box;
  width: 100%;
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border: 2rpx solid #f0e6e6;
  border-radius: 20rpx;
  background: #ffffff;
  color: #3d2c2c;
  font-size: 26rpx;
  line-height: 36rpx;
}

.dev-input {
  height: 76rpx;
  padding-top: 0;
  padding-bottom: 0;
  line-height: 76rpx;
}

.dev-actions,
.note-actions,
.inspiration-actions,
.detail-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.dev-actions {
  margin-top: 16rpx;
}

.compact-button {
  min-width: 0;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 32rpx;
  font-size: 23rpx;
  line-height: 64rpx;
}

.inspirations-page .button-primary {
  background: #e8856c;
  color: #ffffff;
}

.inspirations-page .button-secondary {
  background: #fff0eb;
  color: #e8856c;
}

.clear-button {
  margin: 14rpx 0 0;
  padding: 0;
  color: #a08578;
  font-size: 22rpx;
  line-height: 34rpx;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 36rpx 0 24rpx;
}

.page-title {
  color: #3d2c2c;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.page-subtitle {
  margin-top: 6rpx;
  color: #8b7070;
  font-size: 24rpx;
  line-height: 32rpx;
}

.refresh-button,
.detail-link,
.note-edit-button,
.back-button {
  margin: 0;
  padding: 0;
  color: #e8856c;
  font-size: 24rpx;
  line-height: 36rpx;
}

.inspiration-card {
  display: flex;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 0;
}

.inspiration-cover {
  flex: 0 0 224rpx;
  width: 224rpx;
  height: 520rpx;
  background: #f5eeee;
}

.placeholder-cover {
  background: #f5eeee;
}

.inspiration-content {
  min-width: 0;
  flex: 1;
  padding: 28rpx 24rpx;
}

.inspiration-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.inspiration-title {
  min-width: 0;
  flex: 1;
  color: #3d2c2c;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
  overflow-wrap: anywhere;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 24rpx;
  background: #fff0eb;
  color: #a45f67;
  font-size: 21rpx;
  line-height: 28rpx;
}

.inspiration-description {
  margin-top: 14rpx;
  color: #6b5555;
  font-size: 24rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
}

.note-label,
.detail-section-title {
  margin-top: 20rpx;
  color: #8b7070;
  font-size: 22rpx;
  line-height: 30rpx;
}

.note-view {
  margin-top: 6rpx;
  color: #3d2c2c;
  font-size: 24rpx;
  line-height: 34rpx;
  overflow-wrap: anywhere;
}

.note-placeholder {
  color: #b7a4a0;
}

.note-input {
  min-height: 80rpx;
  margin-top: 8rpx;
}

.note-actions {
  margin-top: 12rpx;
}

.note-edit-button {
  display: block;
  margin-top: 8rpx;
}

.inspiration-meta {
  margin-top: 18rpx;
  color: #a08578;
  font-size: 21rpx;
  line-height: 30rpx;
}

.inspiration-actions {
  margin-top: 18rpx;
}

.danger-button {
  color: #d45a5a !important;
}

.is-unavailable {
  display: block;
  padding: 28rpx;
  background: #fff8f5;
}

.unavailable-content {
  min-width: 0;
}

.state-card {
  display: flex;
  min-height: 420rpx;
  margin-top: 36rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  text-align: center;
}

.state-symbol {
  font-size: 64rpx;
  line-height: 1;
}

.state-title {
  margin-top: 20rpx;
  color: #3d2c2c;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.state-desc {
  margin-top: 12rpx;
  color: #8b7070;
  font-size: 25rpx;
  line-height: 38rpx;
}

.state-action {
  min-width: 240rpx;
  margin-top: 28rpx;
}

.state-card-error .state-symbol,
.state-card-error .state-title {
  color: #d45a5a;
}

.load-more-button {
  display: block;
  width: 280rpx;
  margin: 20rpx auto;
}

.load-more-text {
  padding: 18rpx 0 32rpx;
  color: #a08578;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.detail-card {
  margin-top: 36rpx;
}

.back-button {
  display: block;
  margin-bottom: 22rpx;
}

.detail-cover {
  display: block;
  width: 100%;
  height: 560rpx;
  border-radius: 24rpx;
  background: #f5eeee;
}

.detail-card .detail-title {
  margin-top: 24rpx;
  color: #3d2c2c;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.detail-action {
  margin-top: 20rpx;
}

.detail-actions {
  margin-top: 24rpx;
}

.unavailable-detail-card {
  text-align: center;
}

.unavailable-detail-card .back-button {
  text-align: left;
}

.unavailable-detail-card .detail-title {
  margin-top: 20rpx;
}

.unavailable-detail-card .note-view {
  margin-top: 24rpx;
  text-align: left;
}

.detail-delete-button {
  display: inline-block;
  margin-top: 24rpx;
}
