<view class="container gallery-page">
  <block wx:if="{{pageState === 'ready'}}">
    <view class="gallery-header">
      <view class="gallery-header-copy">
        <view class="gallery-heading">返图灵感</view>
        <view class="gallery-subheading">热门返图 · 找到你的心动款</view>
      </view>
      <view class="gallery-all-label">全部</view>
    </view>

    <view class="gallery-filter-row">
      <view
        wx:for="{{filters}}"
        wx:key="label"
        class="gallery-filter {{activeTag === item.tag ? 'is-active' : ''}}"
        data-tag="{{item.tag}}"
        bindtap="onFilterTap"
      >{{item.label}}</view>
    </view>

    <view class="gallery-grid">
      <view wx:for="{{galleryItems}}" wx:key="id" class="gallery-card" data-id="{{item.id}}" bindtap="goGalleryDetail">
        <image wx:if="{{item.imageUrl}}" class="gallery-image" mode="aspectFill" src="{{item.imageUrl}}" />
        <view wx:else class="gallery-image gallery-image-placeholder"></view>
        <view class="gallery-body">
          <view class="gallery-meta-row">
            <view class="gallery-title">{{item.title}}</view>
            <view wx:if="{{item.publishedAtText}}" class="gallery-time">{{item.publishedAtText}}</view>
          </view>
          <view wx:if="{{item.tags.length}}" class="gallery-tags">
            <text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text>
          </view>
          <view class="gallery-desc">{{item.description || '点击查看详情多图'}}</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:elif="{{pageState === 'loading'}}" class="state-card card">
    <view class="state-symbol">⌛</view>
    <view class="state-title">返图加载中</view>
    <view class="state-desc">正在读取最新返图</view>
  </view>

  <view wx:elif="{{pageState === 'empty'}}" class="state-card card">
    <view class="state-symbol">⌁</view>
    <view class="state-title">暂无返图</view>
    <view class="state-desc">{{stateMessage || '内容整理中，请稍后'}}</view>
  </view>

  <view wx:else class="state-card state-card-error card">
    <view class="state-symbol">⚠</view>
    <view class="state-title">加载失败</view>
    <view class="state-desc">{{stateMessage || '请下拉刷新后重试'}}</view>
  </view>
</view>
