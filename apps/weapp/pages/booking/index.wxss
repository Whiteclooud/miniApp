@import '../../app.wxss';

.identity-card,
.dev-card,
.state-card,
.form-card {
  margin-bottom: 24rpx;
}

.date-scroll {
  margin-top: 12rpx;
  white-space: nowrap;
}

.date-chip-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.date-chip {
  min-width: 200rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff3ef;
  color: #6a5146;
  border: 2rpx solid transparent;
}

.date-chip.selected {
  background: linear-gradient(135deg, #ffb1a0, #ff7c9f);
  color: #ffffff;
  border-color: rgba(255, 124, 159, 0.28);
}

.date-chip-title {
  font-size: 28rpx;
  font-weight: 700;
}

.date-chip-value {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.88;
}

.time-slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 16rpx;
}

.time-slot-card {
  min-height: 148rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  border: 2rpx solid transparent;
  background: #fff6f2;
}

.time-slot-card.is-active {
  background: #fff6f2;
  color: #5f463b;
}

.time-slot-card.is-disabled {
  background: #f4efec;
  color: #b19e95;
}

.time-slot-card.is-selected {
  background: linear-gradient(135deg, #ffb1a0, #ff7c9f);
  color: #ffffff;
  border-color: rgba(255, 124, 159, 0.28);
}

.time-slot-value {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.time-slot-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.time-slot-meta.success {
  color: inherit;
  opacity: 0.88;
}

.warning-text {
  margin-top: 14rpx;
  color: #a45f67;
}

.field-label {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.field-input,
.field-textarea {
  margin-top: 10rpx;
  background: #fff6f2;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.field-textarea {
  min-height: 180rpx;
}
