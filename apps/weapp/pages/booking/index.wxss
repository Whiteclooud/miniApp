@import '../../app.wxss';

.booking-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: #fffaf8;
}

.booking-page button::after {
  border: 0;
}

.booking-page .card {
  box-sizing: border-box;
  border-radius: 32rpx;
  padding: 32rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(61, 44, 44, 0.05);
}

.identity-card,
.dev-card,
.state-card,
.form-card,
.result-card {
  margin-bottom: 32rpx;
}

.identity-label,
.dev-title,
.field-label {
  color: #6b5555;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.identity-value {
  margin-top: 12rpx;
  color: #3d2c2c;
  font-size: 26rpx;
  line-height: 1.4;
  word-break: break-all;
}

.helper-text,
.identity-helper {
  color: #a89999;
  font-size: 22rpx;
  line-height: 1.5;
}

.identity-helper {
  margin-top: 12rpx;
}

.dev-card {
  border: 2rpx solid #f0e6e6;
  background: #fff8f5 !important;
  box-shadow: none !important;
}

.dev-title {
  color: #8b7070;
  font-size: 26rpx;
}

.dev-input,
.field-input,
.field-textarea {
  display: block;
  box-sizing: border-box;
  width: 100%;
  color: #3d2c2c;
  font-size: 26rpx;
}

.dev-input {
  height: 76rpx;
  margin-top: 20rpx;
  padding: 0 24rpx;
  border: 2rpx solid #f0e6e6;
  border-radius: 20rpx;
  background: #ffffff;
}

.dev-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  margin-top: 20rpx;
}

.dev-button {
  margin: 0;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #fff0eb;
  color: #e8856c;
  font-size: 22rpx;
  line-height: 58rpx;
}

.dev-button-clear {
  flex-basis: 222rpx;
  width: 222rpx;
}

.state-card {
  min-height: 510rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.state-symbol,
.result-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  color: #e8856c;
  font-size: 56rpx;
  line-height: 1;
}

.state-title,
.result-title,
.section-title {
  color: #3d2c2c;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
}

.state-title {
  margin-top: 24rpx;
}

.state-desc,
.result-desc {
  margin-top: 20rpx;
  color: #8b7070;
  font-size: 26rpx;
  line-height: 1.6;
}

.state-action {
  width: 100%;
  height: 92rpx;
  margin-top: 28rpx;
  border-radius: 46rpx;
  background: #e8856c;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.loading-skeleton {
  width: 100%;
  margin-top: 32rpx;
}

.skeleton-line {
  height: 24rpx;
  margin-top: 20rpx;
  border-radius: 12rpx;
  background: #f5f0f0;
}

.form-card,
.calendar-card {
  border-radius: 40rpx !important;
  padding: 40rpx !important;
  box-shadow: 0 8rpx 32rpx rgba(61, 44, 44, 0.05) !important;
}

.calendar-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.calendar-switch,
.calendar-today {
  box-sizing: border-box;
  flex: 0 0 auto;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #fff6f2;
  color: #e8856c;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 54rpx;
  text-align: center;
  white-space: nowrap;
}

.calendar-title {
  flex: 1;
  min-width: 0;
  color: #3d2c2c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 54rpx;
  text-align: center;
  white-space: nowrap;
}

.calendar-today {
  padding: 0 18rpx;
  background: #fff0eb;
  font-size: 22rpx;
}

.week-label-row,
.calendar-week {
  display: flex;
  gap: 4rpx;
}

.week-label-row {
  margin-top: 28rpx;
}

.week-label,
.calendar-cell {
  flex: 1;
  min-width: 0;
}

.week-label {
  color: #8b7070;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 56rpx;
  text-align: center;
}

.calendar-week {
  margin-top: 16rpx;
}

.calendar-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  background: #ffffff;
}

.calendar-day-number {
  color: #3d2c2c;
  font-size: 26rpx;
  line-height: 1;
}

.calendar-cell-active {
  background: #ffffff;
}

.calendar-cell-disabled {
  background: #f5f0f0;
}

.calendar-cell-disabled .calendar-day-number {
  color: #c4b5b5;
}

.calendar-cell-muted {
  background: #fafafa;
}

.calendar-cell-muted .calendar-day-number {
  color: #d9cccc;
}

.calendar-code-DATE_CLOSED {
  background: #fff0eb;
}

.calendar-code-DATE_CLOSED .calendar-day-number {
  color: #c97a6a;
}

.calendar-code-DATE_OUT_OF_RANGE {
  background: #fafafa;
}

.calendar-cell-today {
  border-color: #e8856c;
  background: #fff6f2;
}

.calendar-cell-today .calendar-day-number {
  color: #e8856c;
  font-weight: 600;
}

.calendar-cell-selected {
  border-color: #e8856c;
  background: #e8856c;
  box-shadow: 0 8rpx 16rpx rgba(232, 133, 108, 0.18);
}

.calendar-cell-selected .calendar-day-number {
  color: #ffffff;
  font-weight: 700;
}

.calendar-legend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 28rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9cccc;
}

.legend-active,
.legend-AVAILABLE {
  background: #e8856c;
}

.legend-SLOT_OCCUPIED {
  background: #e3d6d6;
}

.legend-DATE_CLOSED {
  background: #f4c8bc;
}

.legend-DATE_OUT_OF_RANGE {
  background: #f3eeee;
}

.legend-text {
  color: #8b7070;
  font-size: 20rpx;
  line-height: 1.3;
}

.availability-notice {
  margin-top: 18rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fff6f2;
  color: #a46b5d;
  font-size: 22rpx;
  line-height: 1.5;
}

.time-slot-title {
  margin-top: 28rpx;
}

.time-slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  width: 100%;
  margin-top: 18rpx;
}

.time-slot-card {
  display: flex;
  box-sizing: border-box;
  min-height: 136rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #f0e6e6;
  border-radius: 24rpx;
  background: #ffffff;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.time-slot-card.is-active {
  background: #ffffff;
}

.time-slot-card.is-disabled {
  background: #f5f0f0;
}

.time-slot-card.is-selected {
  border-color: #e8856c;
  background: #fff6f2;
}

.time-slot-value {
  color: #3d2c2c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.is-selected .time-slot-value,
.is-selected .time-slot-meta {
  color: #e8856c;
}

.is-disabled .time-slot-value,
.is-disabled .time-slot-meta {
  color: #c4b5b5;
}

.time-slot-meta {
  margin-top: 6rpx;
  color: #a89999;
  font-size: 22rpx;
  line-height: 1.3;
  text-align: center;
}

.form-divider {
  height: 2rpx;
  margin: 32rpx 0 28rpx;
  background: #f0e6e6;
}

.booking-info-title {
  margin-bottom: 28rpx;
}

.form-field + .form-field {
  margin-top: 28rpx;
}

.field-label {
  color: #6b5555;
  font-size: 26rpx;
}

.reference-field-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.reference-image-count,
.field-helper {
  color: #a89999;
  font-size: 22rpx;
  line-height: 1.5;
}

.field-helper {
  margin-top: 10rpx;
}

.reference-image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.reference-image-item,
.reference-image-add {
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 16rpx;
}

.reference-image-item {
  background: #f5eeee;
}

.reference-image {
  display: block;
  width: 100%;
  height: 100%;
}

.reference-image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(61, 44, 44, 0.7);
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1;
}

.reference-image-add {
  display: flex;
  border: 2rpx dashed #e3d6d6;
  background: #fff8f5;
  color: #e8856c;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.reference-image-add.is-disabled {
  opacity: 0.55;
}

.reference-image-add-icon {
  font-size: 44rpx;
  line-height: 1;
}

.reference-image-add-text {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.2;
}

.reference-image-message {
  margin-top: 12rpx;
  color: #bd5e4b;
  font-size: 22rpx;
  line-height: 1.5;
}

.field-input,
.field-textarea {
  margin-top: 16rpx;
  border: 2rpx solid #f0e6e6;
  border-radius: 20rpx;
  background: #fff8f5;
}

.field-input {
  height: 86rpx;
  padding: 0 28rpx;
  line-height: 86rpx;
}

.field-textarea {
  height: 144rpx;
  padding: 20rpx 28rpx;
  line-height: 1.5;
}

.inline-error {
  margin-top: 24rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fff0eb;
  color: #bd5e4b;
  font-size: 24rpx;
  line-height: 1.5;
}

.booking-submit {
  width: 100%;
  height: 102rpx;
  margin-top: 32rpx;
  border-radius: 51rpx;
  background: #e8856c;
  box-shadow: 0 12rpx 20rpx rgba(232, 133, 108, 0.22);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 102rpx;
}

.result-card {
  min-height: 590rpx;
  padding: 48rpx !important;
  text-align: center;
}

.result-symbol {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto;
  font-size: 72rpx;
}

.result-title {
  margin-top: 20rpx;
  font-size: 34rpx;
}

.result-details {
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #fff8f5;
  text-align: left;
}

.result-detail-row {
  color: #6b5555;
  font-size: 24rpx;
  line-height: 1.8;
}

.result-desc {
  font-size: 24rpx;
}

.result-actions {
  margin-top: 28rpx;
}

.result-action {
  width: 100%;
  height: 92rpx;
  margin: 0;
  border-radius: 46rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.result-action + .result-action {
  margin-top: 20rpx;
}

.result-actions .button-primary {
  background: #e8856c;
  color: #ffffff;
}

.result-actions .button-secondary {
  background: #fff0eb;
  color: #e8856c;
}
