@import '../../app.wxss';

.identity-card,
.dev-card,
.state-card,
.form-card {
  margin-bottom: 24rpx;
}

.calendar-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff8f5;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.calendar-title {
  font-size: 30rpx;
  font-weight: 700;
}

.calendar-switch {
  min-width: 120rpx;
  border-radius: 999rpx;
  background: #fff0ea;
  color: #8d5f55;
  font-size: 24rpx;
}

.today-button {
  margin-top: 16rpx;
}

.calendar-legend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 18rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #d9c9c2;
}

.legend-active,
.legend-AVAILABLE {
  background: #ff8fa6;
}

.legend-SLOT_OCCUPIED {
  background: #a48d84;
}

.legend-DATE_CLOSED {
  background: #d2b8ae;
}

.legend-DATE_OUT_OF_RANGE {
  background: #e4dbd7;
}

.legend-text {
  color: #7d5b4c;
  font-size: 22rpx;
}

.week-label-row,
.calendar-week {
  display: flex;
}

.week-label-row {
  margin-top: 18rpx;
}

.week-label,
.calendar-cell {
  flex: 1;
}

.week-label {
  text-align: center;
  color: #96786a;
  font-size: 22rpx;
}

.calendar-cell {
  min-height: 132rpx;
  margin-top: 12rpx;
  padding: 14rpx 10rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 2rpx solid transparent;
}

.calendar-cell-muted {
  opacity: 0.55;
}

.calendar-cell-selected {
  border-color: rgba(255, 124, 159, 0.28);
  box-shadow: 0 10rpx 20rpx rgba(255, 124, 159, 0.12);
}

.calendar-cell-active {
  background: #fff4f2;
}

.calendar-cell-disabled {
  background: #f4efec;
}

.calendar-day-row {
  display: flex;
  justify-content: center;
}

.calendar-day-number {
  font-size: 28rpx;
  font-weight: 700;
  color: #5f463b;
}

.calendar-day-today {
  color: #ff6f91;
}

.calendar-reason {
  margin-top: 10rpx;
  color: #8f766b;
  font-size: 20rpx;
  line-height: 1.4;
  text-align: center;
}

.warning-text {
  margin-top: 14rpx;
  color: #a45f67;
}

.time-slot-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 16rpx;
}

.time-slot-card {
  min-height: 148rpx;
  padding: 22rpx 20rpx;
  border-radius: 22rpx;
  border: 2rpx solid transparent;
  background: #fff6f2;
}

.time-slot-card.is-active {
  background: #fff6f2;
  color: #5f463b;
}

.time-slot-card.is-disabled {
  background: #f4efec;
  color: #b19e95;
}

.time-slot-card.is-selected {
  background: linear-gradient(135deg, #ffb1a0, #ff7c9f);
  color: #ffffff;
  border-color: rgba(255, 124, 159, 0.28);
}

.time-slot-value {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.time-slot-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

.time-slot-meta.success {
  color: inherit;
  opacity: 0.88;
}

.field-label {
  margin-top: 22rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.field-input,
.field-textarea {
  margin-top: 10rpx;
  background: #fff6f2;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.field-textarea {
  min-height: 180rpx;
}
