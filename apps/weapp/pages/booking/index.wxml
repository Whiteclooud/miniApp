<view class="container">
  <view class="card identity-card">
    <view class="identity-label">顾客身份主键</view>
    <view class="identity-value">{{customerIdentity.openId || customerIdentity.label}}</view>
    <view class="helper-text">{{customerIdentity.sourceText || '预约提交会通过 X-Customer-OpenId 识别顾客归属。'}}</view>
  </view>

  <view wx:if="{{customerIdentity.isDevelopEnv}}" class="card dev-card">
    <view class="identity-label">开发环境模拟顾客 OpenID</view>
    <input class="field-input" value="{{customerOpenIdInput}}" bindinput="onCustomerOpenIdInput" placeholder="可填写固定 mock OpenID，便于提交后到“我的预约”查询" />
    <view class="action-row">
      <button class="button-primary compact-button" bindtap="applyCustomerOpenId">保存 OpenID</button>
      <button class="button-secondary compact-button" bindtap="generateCustomerOpenId">生成模拟 OpenID</button>
    </view>
    <button class="button-ghost compact-button button-row-spacer" bindtap="clearCustomerOpenId">清空顾客 OpenID</button>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="card state-card">
    <view class="state-title">预约数据加载中</view>
    <view class="state-desc">正在获取 availability?date=YYYY-MM-DD 对应的可预约时段，请稍候。</view>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="card state-card">
    <view class="state-title">预约页加载失败</view>
    <view class="state-desc">{{stateMessage || '预约页依赖的接口未跑通时，会在这里显式提示。'}}</view>
    <button class="button-secondary" bindtap="loadPage">重新加载</button>
  </view>

  <view wx:elif="{{pageState === 'unauthorized'}}" class="card state-card">
    <view class="state-title">顾客身份不可用</view>
    <view class="state-desc">{{stateMessage || '缺少顾客 OpenID，无法继续查询或提交预约。'}}</view>
    <button class="button-secondary" bindtap="loadPage">重新检查</button>
  </view>

  <view wx:elif="{{pageState === 'empty'}}" class="card state-card">
    <view class="state-title">当前暂无可预约时段</view>
    <view class="state-desc">{{stateMessage || 'availability 接口已返回，但当前没有可约日期或时段。'}}</view>
    <button class="button-secondary" bindtap="loadPage">重新加载</button>
  </view>

  <view wx:else class="card form-card">
    <view class="field-label">日期</view>
    <picker mode="selector" range="{{dateOptions}}" range-key="label" value="{{dateIndex}}" bindchange="onDateChange">
      <view class="field-picker">{{dateOptions[dateIndex] ? dateOptions[dateIndex].label : '请选择日期'}}</view>
    </picker>
    <view class="helper-text">切换日期时会重新调用 availability 接口，并使用固定 query key：date。</view>

    <view class="field-label">可预约时间段</view>
    <picker mode="selector" range="{{timeSlotOptions}}" range-key="label" value="{{timeSlotIndex}}" bindchange="onTimeSlotChange">
      <view class="field-picker">{{timeSlotOptions[timeSlotIndex] ? timeSlotOptions[timeSlotIndex].label : '请选择时间段'}}</view>
    </picker>

    <view class="field-label">姓名（选填，仅用于联系）</view>
    <input class="field-input" data-field="customerName" value="{{form.customerName}}" bindinput="onInput" placeholder="如需门店回访，可填写联系人姓名" />

    <view class="field-label">手机号（选填，仅用于联系）</view>
    <input class="field-input" data-field="phone" value="{{form.phone}}" bindinput="onInput" type="number" placeholder="如需门店联系，可填写手机号" />
    <view class="helper-text">姓名和手机号只作为联系信息，不影响预约归属；预约归属只认当前顾客 OpenID。</view>

    <view class="field-label">备注（选填）</view>
    <textarea class="field-textarea" data-field="note" value="{{form.note}}" bindinput="onInput" placeholder="如需指定风格或注意事项，可填写备注" />

    <view wx:if="{{submitMessage}}" class="inline-error">{{submitMessage}}</view>
    <button class="button-primary" bindtap="submit" loading="{{submitState === 'submitting'}}">提交预约</button>
  </view>
</view>
