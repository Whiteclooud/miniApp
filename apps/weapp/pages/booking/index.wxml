<view class="container booking-page">
  <view wx:if="{{customerIdentity.isDevelopEnv && pageState !== 'unauthorized' && submitState !== 'success'}}" class="card identity-card">
    <view class="identity-label">顾客身份主键</view>
    <view class="identity-value">{{customerIdentity.openId || customerIdentity.label}}</view>
    <view class="helper-text identity-helper">{{customerIdentity.sourceText}}</view>
  </view>

  <view wx:if="{{customerIdentity.isDevelopEnv && (pageState === 'ready' || pageState === 'unauthorized') && submitState !== 'success'}}" class="card dev-card">
    <view class="dev-title">🛠 开发环境：模拟顾客 OpenID</view>
    <input class="dev-input" value="{{customerOpenIdInput}}" bindinput="onCustomerOpenIdInput" placeholder="输入自定义 OpenID..." />
    <view class="dev-action-row">
      <button class="dev-button" bindtap="applyCustomerOpenId">保存 OpenID</button>
      <button class="dev-button" bindtap="generateCustomerOpenId">生成模拟 OpenID</button>
      <button class="dev-button dev-button-clear" bindtap="clearCustomerOpenId">清空顾客 OpenID</button>
    </view>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="card state-card state-card-loading">
    <view class="state-symbol">⏳</view>
    <view class="state-title">预约数据加载中</view>
    <view class="state-desc">正在获取可预约时段，请稍候...</view>
    <view class="loading-skeleton">
      <view class="skeleton-line"></view>
      <view class="skeleton-line"></view>
      <view class="skeleton-line"></view>
    </view>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="card state-card">
    <view class="state-symbol">⚠</view>
    <view class="state-title">预约页加载失败</view>
    <view class="state-desc">{{stateMessage || '网络连接异常或服务暂时不可用，请检查网络后重试。'}}</view>
    <button class="button-primary state-action" bindtap="loadPage">重新加载</button>
  </view>

  <view wx:elif="{{pageState === 'unauthorized'}}" class="card state-card">
    <view class="state-symbol">🔒</view>
    <view class="state-title">顾客身份不可用</view>
    <view class="state-desc">{{stateMessage || '无法识别您的顾客身份，请确认已在微信环境内打开小程序，或联系店铺工作人员。'}}</view>
    <button class="button-primary state-action" bindtap="loadPage">重新检查</button>
  </view>

  <view wx:elif="{{pageState === 'empty'}}" class="card state-card">
    <view class="state-symbol">⌁</view>
    <view class="state-title">当前暂无可预约时段</view>
    <view class="state-desc">{{stateMessage || '店铺近期未开放预约时段，请稍后再试或联系店铺了解详情。'}}</view>
    <button class="button-primary state-action" bindtap="loadPage">重新加载</button>
  </view>

  <block wx:else>
    <view wx:if="{{submitState === 'success'}}" class="card result-card">
      <view class="result-symbol">🎉</view>
      <view class="result-title">预约已提交</view>
      <view class="result-details">
        <view class="result-detail-row">预约日期：{{submitResult.date}}</view>
        <view class="result-detail-row">预约时段：{{submitResult.timeSlot}}</view>
      </view>
      <view class="result-desc">预约信息已记录，店铺确认后会通过微信通知您。</view>
      <view class="result-actions">
        <button class="button-primary result-action" bindtap="goMyBookings">查看我的预约</button>
        <button class="button-secondary result-action" bindtap="bookAgain">再约一次</button>
      </view>
    </view>

    <view wx:else class="card form-card calendar-card">
      <view class="section-title">选择日期</view>
      <view class="calendar-header">
        <view class="calendar-switch" data-delta="-1" bindtap="changeMonth">‹ 上月</view>
        <view class="calendar-title">{{monthLabel}}</view>
        <view class="calendar-switch" data-delta="1" bindtap="changeMonth">下月 ›</view>
        <view class="calendar-today" bindtap="resetToCurrentMonth">回到本月</view>
      </view>

      <view class="week-label-row">
        <view wx:for="{{weekLabels}}" wx:key="*this" class="week-label">{{item}}</view>
      </view>
      <view wx:for="{{calendarWeeks}}" wx:key="index" class="calendar-week">
        <view
          wx:for="{{item}}"
          wx:key="key"
          class="calendar-cell {{item.isCurrentMonth ? '' : 'calendar-cell-muted'}} {{item.isSelected ? 'calendar-cell-selected' : ''}} {{item.isToday ? 'calendar-cell-today' : ''}} {{item.status === 'active' ? 'calendar-cell-active' : 'calendar-cell-disabled'}} calendar-code-{{item.reasonCode}}"
          data-date="{{item.date}}"
          data-can-tap="{{item.canTap}}"
          bindtap="onCalendarDayTap"
        >
          <text class="calendar-day-number">{{item.dayNumber}}</text>
        </view>
      </view>

      <view class="calendar-legend-row">
        <view wx:for="{{calendarLegend}}" wx:key="key" class="legend-item">
          <text class="legend-dot legend-{{item.status}} legend-{{item.key}}"></text>
          <text class="legend-text">{{item.label}}</text>
        </view>
      </view>
      <view wx:if="{{availabilityNoticeText}}" class="availability-notice">{{availabilityNoticeText}}</view>

      <view class="section-title time-slot-title">可预约时间段</view>
      <view class="time-slot-grid">
        <view
          wx:for="{{timeSlotOptions}}"
          wx:key="id"
          class="time-slot-card {{item.status === 'active' ? 'is-active' : 'is-disabled'}} {{selectedTimeSlotValue === item.value ? 'is-selected' : ''}}"
          data-value="{{item.value}}"
          data-status="{{item.status}}"
          data-reason-text="{{item.reasonText}}"
          data-reason-code="{{item.reasonCode}}"
          bindtap="onTimeSlotTap"
        >
          <view class="time-slot-value">{{item.label}}</view>
          <view class="time-slot-meta" wx:if="{{item.status === 'disabled' && (item.reasonText || item.reasonCode)}}">{{item.reasonText || item.reasonCode}}</view>
          <view class="time-slot-meta success" wx:elif="{{item.status === 'active'}}">可预约</view>
        </view>
      </view>
      <view wx:if="{{timeSlotStateMessage}}" class="availability-notice">{{timeSlotStateMessage}}</view>

      <view class="form-divider"></view>
      <view class="section-title booking-info-title">预约信息</view>

      <view class="form-field">
        <view class="field-label">姓名</view>
        <input class="field-input" data-field="customerName" value="{{form.customerName}}" bindinput="onInput" placeholder="请输入姓名" />
      </view>

      <view class="form-field">
        <view class="field-label">手机号</view>
        <input class="field-input" data-field="phone" value="{{form.phone}}" bindinput="onInput" type="number" placeholder="请输入手机号" />
      </view>

      <view class="form-field">
        <view class="reference-field-header">
          <view class="field-label">参考图（可选）</view>
          <view class="reference-image-count">{{referenceImageUrls.length}} / {{maxReferenceImageCount}}</view>
        </view>
        <view class="field-helper">可上传想做的美甲样式；从返图预约时会自动带入当前图片。</view>
        <view class="reference-image-grid">
          <view wx:for="{{referenceImageUrls}}" wx:key="*this" class="reference-image-item">
            <image
              class="reference-image"
              mode="aspectFill"
              src="{{item}}"
              data-url="{{item}}"
              bindtap="previewReferenceImage"
            />
            <view
              wx:if="{{submitState === 'idle' && referenceImageState === 'idle'}}"
              class="reference-image-remove"
              data-index="{{index}}"
              catchtap="removeReferenceImage"
            >×</view>
          </view>
          <view
            wx:if="{{referenceImageUrls.length < maxReferenceImageCount && submitState === 'idle' && referenceImageState === 'idle'}}"
            class="reference-image-add"
            bindtap="addReferenceImages"
          >
            <view class="reference-image-add-icon">+</view>
            <view class="reference-image-add-text">添加图片</view>
          </view>
          <view
            wx:elif="{{referenceImageUrls.length < maxReferenceImageCount}}"
            class="reference-image-add is-disabled"
          >
            <view class="reference-image-add-icon">+</view>
            <view class="reference-image-add-text">{{submitState === 'submitting' ? '提交中' : '处理中'}}</view>
          </view>
        </view>
        <view wx:if="{{referenceImageMessage}}" class="reference-image-message">{{referenceImageMessage}}</view>
      </view>

      <view class="form-field">
        <view class="field-label">备注（可选）</view>
        <textarea class="field-textarea" data-field="note" value="{{form.note}}" bindinput="onInput" placeholder="如有特殊需求请备注..." />
      </view>

      <view wx:if="{{submitMessage}}" class="inline-error">{{submitMessage}}</view>
      <button
        class="button-primary booking-submit"
        bindtap="submit"
        loading="{{submitState === 'submitting'}}"
        disabled="{{submitState === 'submitting' || referenceImageState !== 'idle'}}"
      >提交预约</button>
    </view>
  </block>
</view>
