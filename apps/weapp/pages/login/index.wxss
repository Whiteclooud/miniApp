@import '../../app.wxss';

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 108rpx 32rpx 64rpx;
  background: #fffaf8;
}

.login-card {
  padding: 48rpx;
  border-radius: 40rpx;
}

.login-eyebrow {
  color: #e8856c;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.login-title {
  margin-top: 36rpx;
  color: #3d2c2c;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 68rpx;
}

.login-desc {
  margin-top: 20rpx;
  color: #6b5555;
  font-size: 28rpx;
  line-height: 44rpx;
}

.login-primary {
  width: 100%;
  height: 92rpx;
  margin: 96rpx 0 0;
  border-radius: 46rpx;
  background: #e8856c;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.login-message {
  margin-top: 20rpx;
  color: #b45b55;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.login-agreement {
  margin-top: 32rpx;
  color: #a89999;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.login-cancel {
  display: block;
  margin: 40rpx auto 0;
  padding: 0;
  color: #8b7070;
  font-size: 26rpx;
  line-height: 40rpx;
}
