@import '../../app.wxss';

.detail-page {
  min-height: 100vh;
  background: #fffaf8;
}

.detail-page button::after {
  border: 0;
}

.detail-wrapper {
  overflow: hidden;
  background: #fffaf8;
}

.detail-media {
  position: relative;
  width: 100%;
  height: 760rpx;
  background: #f5eeee;
}

.detail-image {
  display: block;
  width: 100%;
  height: 100%;
  background: #f5eeee;
}

.detail-image-placeholder {
  background: #f5eeee;
}

.image-counter {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  min-width: 72rpx;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background: rgba(61, 44, 44, 0.52);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 26rpx;
  text-align: center;
}

.detail-content-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 640rpx;
  margin-top: -2rpx;
  padding: 48rpx 32rpx 32rpx;
  border-radius: 48rpx 48rpx 0 0;
  background: #ffffff;
}

.studio-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.studio-avatar {
  display: flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8856c;
  color: #ffffff;
  font-size: 28rpx;
  line-height: 1;
}

.studio-name {
  color: #3d2c2c;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 32rpx;
}

.detail-time {
  margin-top: 4rpx;
  color: #a08578;
  font-size: 22rpx;
  line-height: 28rpx;
}

.detail-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 40rpx;
}

.detail-title {
  min-width: 0;
  color: #3d2c2c;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 48rpx;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.tag {
  padding: 12rpx 20rpx;
  border-radius: 28rpx;
  background: #fff0eb;
  color: #a45f67;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 32rpx;
}

.detail-desc {
  margin-top: 24rpx;
  color: #5c463b;
  font-size: 28rpx;
  line-height: 40rpx;
}

.detail-gallery-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-top: 40rpx;
}

.detail-gallery-title {
  color: #3d2c2c;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.detail-gallery-count {
  color: #a08578;
  font-size: 22rpx;
  line-height: 30rpx;
}

.thumbnail-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.thumbnail-row {
  display: inline-flex;
  gap: 32rpx;
  padding-right: 32rpx;
}

.detail-thumbnail {
  box-sizing: border-box;
  width: 148rpx;
  height: 176rpx;
  border: 4rpx solid transparent;
  border-radius: 24rpx;
  background: #f5eeee;
}

.detail-thumbnail.is-active {
  border-color: #e8856c;
}

.detail-page .detail-booking-button {
  width: 100%;
  height: 104rpx;
  margin: 48rpx 0 0;
  border-radius: 52rpx;
  background: #e8856c;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 104rpx;
}

.inspiration-save-block {
  margin-top: 40rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff8f5;
}

.inspiration-save-title {
  color: #3d2c2c;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.inspiration-note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #f0e6e6;
  border-radius: 20rpx;
  background: #ffffff;
  color: #3d2c2c;
  font-size: 24rpx;
  line-height: 34rpx;
}

.detail-page .inspiration-save-button {
  width: 100%;
  min-height: 76rpx;
  margin: 20rpx 0 0;
  border-radius: 38rpx;
  background: #fff0eb;
  color: #e8856c;
  font-size: 26rpx;
  line-height: 76rpx;
}

.state-card {
  display: flex;
  min-height: 460rpx;
  margin-top: 88rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  border-radius: 40rpx;
  color: #8b7070;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
}

.state-symbol {
  font-size: 72rpx;
  line-height: 1;
}

.state-title {
  margin-top: 24rpx;
  color: #6b5555;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.state-desc {
  margin-top: 12rpx;
  color: #8b7070;
  font-size: 26rpx;
  line-height: 36rpx;
}

.state-card-error .state-symbol,
.state-card-error .state-title {
  color: #d45a5a;
}
