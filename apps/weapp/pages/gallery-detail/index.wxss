@import '../../app.wxss';

.detail-wrapper,
.detail-card,
.state-card {
  margin-bottom: 24rpx;
}

.detail-title {
  font-size: 34rpx;
  font-weight: 700;
}

.detail-time {
  margin-top: 12rpx;
  color: #a08578;
  font-size: 22rpx;
}

.detail-tags {
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  margin-right: 12rpx;
  margin-bottom: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #fff1ee;
  color: #a45f67;
  font-size: 22rpx;
}

.detail-desc {
  margin-top: 12rpx;
  color: #5c463b;
  font-size: 26rpx;
  line-height: 1.7;
}

.detail-helper {
  margin-top: 14rpx;
  color: #8a6a5c;
  font-size: 24rpx;
  line-height: 1.6;
}

.image-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.detail-image {
  width: 100%;
  height: 420rpx;
  border-radius: 24rpx;
  background: #f5ece8;
}
