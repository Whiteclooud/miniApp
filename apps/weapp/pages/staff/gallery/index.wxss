@import '../../../app.wxss';

.identity-card,
.dev-card,
.nav-card,
.state-card,
.editor-card,
.list-card {
  margin-bottom: 24rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.action-row-wrap {
  flex-wrap: wrap;
}

.nav-title,
.section-title,
.field-label {
  font-size: 30rpx;
  font-weight: 700;
}

.editor-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  align-items: flex-start;
}

.helper-text,
.state-desc {
  margin-top: 10rpx;
  color: #7d5b4c;
  font-size: 24rpx;
  line-height: 1.6;
}

.field-input,
.field-textarea,
.picker-trigger {
  margin-top: 12rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #fff6f2;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #5f4a42;
}

.field-textarea {
  min-height: 180rpx;
  padding: 20rpx 24rpx;
}

.image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.image-card {
  padding: 16rpx;
  border-radius: 20rpx;
  background: #fff8f5;
}

.image-thumb {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  background: #f2e8e3;
}

.image-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 12rpx;
}

.mini-button {
  margin: 0;
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  background: #fff0ea;
  color: #8d5f55;
  font-size: 22rpx;
}

.mini-button-active {
  background: #2f1d17;
  color: #fff4ee;
}

.mini-button.danger {
  background: #fff1f3;
  color: #c35e72;
}

.picker-grid,
.status-chip-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.status-chip {
  flex: 1;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #fff3ee;
  color: #8a6258;
  text-align: center;
  font-size: 26rpx;
}

.status-chip-active {
  background: #2f1d17;
  color: #fff4ee;
}

.list-title {
  margin-bottom: 16rpx;
}

.gallery-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.list-card {
  overflow: hidden;
  padding: 0;
}

.list-cover {
  width: 100%;
  height: 280rpx;
  background: #f2e8e3;
}

.list-body {
  padding: 24rpx;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}

.list-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
}

.list-desc {
  margin-top: 10rpx;
  color: #6f574b;
  font-size: 24rpx;
  line-height: 1.6;
}

.tag-list {
  margin-top: 12rpx;
}

.tag-item {
  display: inline-block;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ee;
  color: #a45f67;
  font-size: 22rpx;
}
