@import '../../../app.wxss';

.identity-card,
.dev-card,
.nav-card,
.state-card,
.summary-card,
.form-card {
  margin-bottom: 24rpx;
}

.rules-shell {
  padding-bottom: 24rpx;
}

.field-label,
.section-title,
.nav-title {
  font-size: 30rpx;
  font-weight: 700;
}

.helper-text,
.state-desc,
.picker-caption {
  margin-top: 12rpx;
  color: #7d5b4c;
  font-size: 24rpx;
  line-height: 1.6;
}

.field-input,
.picker-trigger {
  margin-top: 12rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #fff6f2;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #5f4a42;
}

.inline-button {
  margin-top: 16rpx;
}

.stepper-row,
.action-row,
.slot-picker-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.action-row-wrap {
  flex-wrap: wrap;
}

.stepper-button {
  flex: 1;
  border-radius: 999rpx;
  background: #fff0ea;
  color: #8d5f55;
  font-size: 24rpx;
}

.chips-row,
.summary-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.option-chip,
.preset-chip,
.summary-chip {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #fff3ee;
  color: #8a6258;
  font-size: 24rpx;
}

.option-chip-active,
.preset-chip-active {
  background: #2f1d17;
  color: #fff4ee;
}

.slot-picker-item {
  flex: 1;
}

.stepper-value {
  flex: 1;
  justify-content: center;
}

.tag-list,
.slot-card-list {
  margin-top: 16rpx;
}

.tag-item,
.slot-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff8f5;
}

.slot-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #43312d;
}

.slot-helper {
  margin-top: 6rpx;
}

.remove-text {
  color: #c35e72;
  font-size: 24rpx;
}

.override-card {
  align-items: flex-start;
}

.override-content {
  flex: 1;
}

.compact-tag {
  margin-bottom: 0;
  padding: 12rpx 16rpx;
}

.staff-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: #fffaf8;
}

.staff-page button::after {
  border: 0;
}

.staff-navigation {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.staff-navigation-tab {
  display: flex;
  min-width: 0;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #fff0eb;
  color: #e8856c;
  font-size: 26rpx;
  line-height: 32rpx;
  text-align: center;
}

.staff-navigation-tab-active {
  background: #e8856c;
  color: #ffffff;
  font-weight: 500;
}

.staff-page .card {
  box-sizing: border-box;
  border-radius: 32rpx;
  padding: 40rpx;
  background: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.045);
}

.staff-page .identity-card,
.staff-page .dev-card,
.staff-page .state-card {
  margin-bottom: 28rpx;
}

.staff-page .identity-label,
.staff-page .field-label,
.staff-page .section-title {
  color: #3d2c2c;
}

.staff-page .helper-text,
.staff-page .state-desc,
.staff-page .picker-caption {
  color: #a89999;
  font-size: 24rpx;
  line-height: 34rpx;
}

.staff-page .dev-card {
  border: 2rpx solid #fff0eb;
  background: #fff8f5;
  box-shadow: none;
}

.staff-page .button-primary {
  background: #e8856c;
  color: #ffffff;
}

.staff-page .button-secondary,
.staff-page .stepper-button {
  background: #fff6f2;
  color: #e8856c;
}

.staff-rules-page .rules-summary-card {
  margin-top: 28rpx;
  padding: 28rpx 24rpx;
}

.staff-rules-page .rules-summary-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}

.staff-rules-page .summary-item {
  min-width: 0;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #fff8f5;
}

.staff-rules-page .summary-value {
  color: #3d2c2c;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 36rpx;
  white-space: nowrap;
}

.staff-rules-page .summary-label {
  margin-top: 8rpx;
  color: #a89999;
  font-size: 22rpx;
  line-height: 28rpx;
}

.staff-rules-page .form-card {
  border-radius: 32rpx;
  padding: 40rpx;
}

.staff-rules-page .option-chip,
.staff-rules-page .preset-chip,
.staff-rules-page .summary-chip {
  border-radius: 24rpx;
  background: #fff0eb;
  color: #e8856c;
}

.staff-rules-page .option-chip-active,
.staff-rules-page .preset-chip-active {
  background: #e8856c;
  color: #ffffff;
}

.staff-rules-page .slot-card,
.staff-rules-page .tag-item {
  border-radius: 24rpx;
  background: #fff8f5;
}

.staff-rules-page .rules-shell > .button-primary {
  width: 100%;
  height: 96rpx;
  margin-top: 24rpx;
  border-radius: 48rpx;
  background: #e8856c;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 96rpx;
}
