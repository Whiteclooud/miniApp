@import '../../../app.wxss';

.title-card,
.auth-card,
.form-card {
  margin-bottom: 24rpx;
}

.title,
.section-title {
  font-size: 34rpx;
  font-weight: 700;
}

.desc,
.section-desc,
.helper-text {
  margin-top: 12rpx;
  color: #7d5b4c;
  font-size: 26rpx;
  line-height: 1.6;
}

.nav-button,
.small-button,
.submit-button {
  margin-top: 20rpx;
}

.field-label {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.field-input,
.field-picker {
  margin-top: 10rpx;
  background: #fff6f2;
  border-radius: 18rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.tag-list {
  margin-top: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 18rpx 20rpx;
  background: #fff8f6;
  border-radius: 18rpx;
  color: #6f574b;
  font-size: 24rpx;
}

.slot-row {
  margin-top: 16rpx;
}

.slot-picker {
  margin-bottom: 12rpx;
}

.remove-text {
  color: #c35e72;
  font-size: 24rpx;
}

.inline-remove {
  display: inline-block;
  margin-top: 4rpx;
}
