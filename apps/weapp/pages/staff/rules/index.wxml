<view class="container">
  <view class="card title-card">
    <view class="title">店员规则配置</view>
    <view class="desc">维护预约开放天数、不可预约日期和每日时间段。</view>
    <button class="button-secondary nav-button" bindtap="goAppointments">查看预约审核</button>
  </view>

  <view wx:if="{{!authorized}}" class="card auth-card">
    <view class="section-title">店员验证</view>
    <view class="section-desc">当前采用 OpenID 白名单联调方案，请先输入店员 OpenID。</view>
    <input class="field-input" bindinput="onAuthInput" value="{{authInput}}" placeholder="请输入店员 OpenID" />
    <button class="button-primary" bindtap="saveAuthInput">保存并加载规则</button>
  </view>

  <block wx:if="{{authorized}}">
    <view class="card form-card">
      <view class="section-title">预约开放规则</view>

      <view class="field-label">提前开放预约天数</view>
      <input class="field-input" type="number" bindinput="onAdvanceDaysInput" value="{{rule.advanceOpenDays}}" placeholder="例如 2" />

      <view class="field-label">不可预约日期</view>
      <picker mode="date" value="{{pickerClosedDate}}" bindchange="onClosedDatePick">
        <view class="field-picker">选择日期：{{pickerClosedDate}}</view>
      </picker>
      <button class="button-secondary small-button" bindtap="addClosedDate">加入不可预约日期</button>
      <view wx:if="{{rule.closedDates.length}}" class="tag-list">
        <view wx:for="{{rule.closedDates}}" wx:key="*this" class="tag-item">
          <text>{{item}}</text>
          <text class="remove-text" data-date="{{item}}" bindtap="removeClosedDate">删除</text>
        </view>
      </view>
      <view wx:else class="helper-text">当前未设置不可预约日期</view>

      <view class="field-label">每日可预约时间段</view>
      <block wx:for="{{rule.dailySlots}}" wx:key="index">
        <view class="slot-row">
          <picker mode="time" value="{{item.start}}" data-index="{{index}}" data-field="start" bindchange="onSlotChange">
            <view class="field-picker slot-picker">开始：{{item.start}}</view>
          </picker>
          <picker mode="time" value="{{item.end}}" data-index="{{index}}" data-field="end" bindchange="onSlotChange">
            <view class="field-picker slot-picker">结束：{{item.end}}</view>
          </picker>
          <text class="remove-text inline-remove" data-index="{{index}}" bindtap="removeSlot">删除</text>
        </view>
      </block>
      <button class="button-secondary small-button" bindtap="addSlot">新增时间段</button>

      <button class="button-primary submit-button" loading="{{saving}}" bindtap="submit">保存规则</button>
    </view>
  </block>
</view>
