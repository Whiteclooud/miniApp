<view class="container">
  <view class="card identity-card">
    <view class="identity-label">店员身份主键</view>
    <view class="identity-value">{{staffIdentity.openId || staffIdentity.label}}</view>
    <view class="helper-text">{{staffIdentity.sourceText}}</view>
  </view>

  <view wx:if="{{staffIdentity.isDevelopEnv}}" class="card dev-card">
    <view class="identity-label">开发环境模拟店员 OpenID</view>
    <input class="field-input" value="{{staffOpenIdInput}}" bindinput="onStaffOpenIdInput" placeholder="填写店员 mock OpenID，便于联调 staff 接口" />
    <view class="action-row">
      <button class="button-primary compact-button" bindtap="applyStaffOpenId">保存并查询</button>
      <button class="button-secondary compact-button" bindtap="generateStaffOpenId">生成模拟 OpenID</button>
    </view>
    <button class="button-ghost compact-button button-row-spacer" bindtap="clearStaffOpenId">清空店员 OpenID</button>
  </view>

  <view class="card nav-card">
    <view class="nav-title">店员工作台</view>
    <view class="action-row action-row-wrap">
      <button class="button-primary compact-button">预约规则</button>
      <button class="button-secondary compact-button" bindtap="goGallery">返图管理</button>
      <button class="button-secondary compact-button" bindtap="goAppointments">预约列表</button>
    </view>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="card state-card">
    <view class="state-title">店员规则加载中</view>
    <view class="state-desc">正在通过 X-Staff-OpenId 获取预约规则，请稍候。</view>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="card state-card">
    <view class="state-title">店员规则页加载失败</view>
    <view class="state-desc">{{stateMessage || '规则接口未跑通时，会在这里显式提示。'}}</view>
    <button class="button-secondary" bindtap="loadData">重新加载</button>
  </view>

  <view wx:elif="{{pageState === 'unauthorized'}}" class="card state-card">
    <view class="state-title">店员身份不可用</view>
    <view class="state-desc">{{stateMessage || '缺少店员 OpenID，当前不能继续查询店员页。'}}</view>
    <button class="button-secondary" bindtap="loadData">重新检查</button>
  </view>

  <view wx:elif="{{pageState === 'empty'}}" class="card state-card">
    <view class="state-title">暂无规则配置</view>
    <view class="state-desc">{{stateMessage || '/api/v1/staff/booking-rules 接口已返回，但当前没有已保存的规则内容。'}}</view>
    <button class="button-primary" bindtap="createDraft">新建规则</button>
    <button class="button-ghost button-row-spacer" bindtap="loadData">重新加载</button>
  </view>

  <view wx:else class="rules-shell">
    <view class="card summary-card">
      <view class="section-title">当前规则摘要</view>
      <view class="summary-chip-list">
        <view wx:for="{{ruleSummary}}" wx:key="*this" class="summary-chip">{{item}}</view>
      </view>
      <view wx:if="{{updatedAtText}}" class="helper-text">最近更新时间：{{updatedAtText}}</view>
    </view>

    <view class="card form-card">
      <view class="field-label">提前开放天数</view>
      <picker mode="selector" range="{{advanceOpenDayOptions}}" range-key="label" value="{{advanceOpenDaysIndex}}" bindchange="onAdvanceOpenDaysPickerChange">
        <view class="picker-trigger">{{form.advanceOpenDays}} 天</view>
      </picker>
      <view class="stepper-row">
        <button class="stepper-button" data-delta="-1" bindtap="stepAdvanceOpenDays">-1 天</button>
        <button class="stepper-button" data-delta="1" bindtap="stepAdvanceOpenDays">+1 天</button>
      </view>
      <view class="chips-row">
        <view wx:for="{{advanceOpenDayOptions}}" wx:key="value" class="option-chip {{item.active ? 'option-chip-active' : ''}}" data-value="{{item.value}}" bindtap="pickAdvanceOption">{{item.label}}</view>
      </view>
      <view class="helper-text">使用冻结契约字段 advanceOpenDays，但前端改为可选控件，不再要求直接输入原始数字。</view>
    </view>

    <view class="card form-card">
      <view class="field-label">闭店日期</view>
      <picker mode="date" value="{{draftClosedDate}}" bindchange="onDraftClosedDateChange">
        <view class="picker-trigger">{{draftClosedDate || '选择一个闭店日期'}}</view>
      </picker>
      <button class="button-secondary compact-button inline-button" bindtap="addClosedDate">添加闭店日期</button>
      <view wx:if="{{form.closedDates.length}}" class="tag-list">
        <view wx:for="{{form.closedDates}}" wx:key="*this" class="tag-item">
          <text>{{item}}</text>
          <text class="remove-text" data-date="{{item}}" bindtap="removeClosedDate">移除</text>
        </view>
      </view>
      <view wx:else class="helper-text">当前未设置闭店日期。</view>
    </view>

    <view class="card form-card">
      <view class="field-label">每日可预约时段</view>
      <view class="slot-picker-grid">
        <view class="slot-picker-item">
          <view class="picker-caption">开始时间</view>
          <picker mode="time" value="{{draftSlotStart}}" data-field="draftSlotStart" bindchange="onDraftSlotTimeChange">
            <view class="picker-trigger">{{draftSlotStart}}</view>
          </picker>
        </view>
        <view class="slot-picker-item">
          <view class="picker-caption">结束时间</view>
          <picker mode="time" value="{{draftSlotEnd}}" data-field="draftSlotEnd" bindchange="onDraftSlotTimeChange">
            <view class="picker-trigger">{{draftSlotEnd}}</view>
          </picker>
        </view>
      </view>
      <button class="button-secondary compact-button inline-button" bindtap="addDailySlot">添加时段</button>
      <view class="chips-row preset-row">
        <view wx:for="{{slotPresetOptions}}" wx:key="slot" class="preset-chip {{item.active ? 'preset-chip-active' : ''}}" data-start="{{item.start}}" data-end="{{item.end}}" bindtap="applySlotPreset">{{item.label}}</view>
      </view>
      <view wx:if="{{form.dailySlots.length}}" class="slot-card-list">
        <view wx:for="{{form.dailySlots}}" wx:key="*this" class="slot-card">
          <view>
            <view class="slot-title">{{item}}</view>
            <view class="helper-text slot-helper">保存时仍按 dailySlots 数组提交。</view>
          </view>
          <text class="remove-text" data-slot="{{item}}" bindtap="removeDailySlot">删除</text>
        </view>
      </view>
      <view wx:else class="helper-text">请至少添加一个时段。</view>
    </view>

    <view wx:if="{{submitMessage}}" class="inline-error">{{submitMessage}}</view>
    <button class="button-primary" bindtap="submit" loading="{{submitState === 'submitting'}}">保存规则</button>
  </view>
</view>
