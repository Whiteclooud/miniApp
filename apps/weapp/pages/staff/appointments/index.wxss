@import '../../../app.wxss';

.identity-card,
.dev-card,
.nav-card,
.state-card,
.summary-card,
.workbench-card,
.filter-card,
.review-notice-card,
.calendar-card,
.detail-card,
.booking-card,
.empty-subcard {
  margin-bottom: 24rpx;
}

.section-title,
.nav-title,
.detail-title,
.section-subtitle {
  font-size: 30rpx;
  font-weight: 700;
}

.section-desc,
.helper-text,
.state-desc {
  margin-top: 12rpx;
  color: #7d5b4c;
  font-size: 24rpx;
  line-height: 1.6;
}

.field-input {
  margin-top: 12rpx;
  background: #fff6f2;
  border-radius: 20rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.picker-trigger {
  margin-top: 12rpx;
  min-height: 82rpx;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #fff6f2;
  color: #5f4a42;
  font-size: 26rpx;
}

.workbench-grid,
.filter-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 16rpx;
}

.workbench-panel {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff8f3;
}

.mini-list {
  margin-top: 18rpx;
}

.mini-list-row {
  padding: 12rpx 0;
  color: #5f4a42;
  font-size: 24rpx;
  border-top: 1rpx solid #f0e2dc;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
}

.summary-grid-quad {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.summary-item {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff7f3;
}

.summary-label {
  font-size: 24rpx;
  color: #8e6558;
}

.summary-value {
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2d28;
}

.summary-helper {
  margin-top: 16rpx;
}

.review-notice-card {
  background: #fff8f3;
}

.review-notice-title {
  font-size: 26rpx;
  font-weight: 700;
}

.review-notice-text {
  margin-top: 10rpx;
  color: #7d5b4c;
  font-size: 24rpx;
  line-height: 1.6;
}

.calendar-header,
.calendar-week,
.action-row,
.booking-header,
.info-row,
.calendar-day-row,
.calendar-badges {
  display: flex;
}

.action-row-wrap {
  flex-wrap: wrap;
}

.calendar-header {
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.calendar-title {
  font-size: 30rpx;
  font-weight: 700;
}

.calendar-switch {
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #fff0ea;
  color: #8d5f55;
  font-size: 24rpx;
}

.today-button {
  margin-top: 16rpx;
}

.week-label-row {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 20rpx;
}

.week-label {
  text-align: center;
  font-size: 22rpx;
  color: #8a665a;
}

.calendar-week {
  gap: 12rpx;
  margin-top: 12rpx;
}

.calendar-cell {
  flex: 1;
  min-height: 180rpx;
  padding: 16rpx 12rpx;
  border-radius: 18rpx;
  background: #fff8f4;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.calendar-cell-muted {
  opacity: 0.45;
}

.calendar-cell-selected {
  border-color: #2f1d17;
  background: #fff1ea;
}

.calendar-day-row {
  align-items: center;
  justify-content: space-between;
}

.calendar-day-number {
  font-size: 28rpx;
  font-weight: 700;
  color: #4b3630;
}

.calendar-day-today {
  color: #c35e72;
}

.calendar-count {
  font-size: 22rpx;
  color: #8e6558;
}

.calendar-badges {
  flex-direction: column;
  gap: 8rpx;
  margin-top: 12rpx;
}

.calendar-customers {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.calendar-customer {
  max-width: 100%;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.84);
  color: #6d4f43;
  font-size: 20rpx;
  line-height: 1.4;
}

.calendar-customer.more {
  color: #c35e72;
}

.calendar-badge {
  display: inline-flex;
  align-self: flex-start;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.calendar-badge.pending,
.status-pill.pending {
  background: #fff3d9;
  color: #a87500;
}

.calendar-badge.approved,
.status-pill.approved {
  background: #e5f8eb;
  color: #1f8a49;
}

.calendar-badge.rejected,
.status-pill.rejected {
  background: #fde8e8;
  color: #b24444;
}

.status-pill.cancelled,
.status-pill.completed,
.status-pill.no_show {
  background: #f0ece8;
  color: #7d5b4c;
}

.detail-filter-scroll {
  margin-top: 18rpx;
  white-space: nowrap;
}

.detail-filter-row {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 6rpx;
}

.detail-filter-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #fff8f3;
  border: 2rpx solid transparent;
  color: #8a6a5c;
}

.detail-filter-chip-active {
  background: #fff1ea;
  border-color: #ff8f87;
  color: #cc5d67;
  box-shadow: 0 10rpx 24rpx rgba(204, 93, 103, 0.12);
}

.detail-filter-label {
  font-size: 24rpx;
  font-weight: 600;
}

.detail-filter-count {
  min-width: 36rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  text-align: center;
  font-size: 22rpx;
}

.detail-filter-helper {
  margin-top: 14rpx;
}

.day-detail-list {
  margin-top: 18rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.day-detail-item {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff8f3;
}

.day-detail-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.day-detail-slot {
  font-size: 28rpx;
  font-weight: 700;
  color: #3d2d28;
}

.day-detail-meta,
.day-detail-note {
  margin-top: 12rpx;
  color: #6d4f43;
  font-size: 24rpx;
  line-height: 1.6;
}

.appointment-reference-block,
.appointment-reference-scroll {
  margin-top: 14rpx;
}

.appointment-reference-scroll {
  width: 100%;
  white-space: nowrap;
}

.appointment-reference-row {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 20rpx;
}

.appointment-reference-image {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  background: #f5eeee;
}

.compact-state-card {
  margin-top: 18rpx;
}

.booking-header,
.info-row {
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.booking-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #3d2d28;
}

.status-pill {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.info-row {
  margin-top: 14rpx;
}

.info-label {
  width: 140rpx;
  color: #8a665a;
  font-size: 24rpx;
}

.info-value {
  flex: 1;
  text-align: right;
  color: #44332d;
  font-size: 24rpx;
}

.review-action-row {
  margin-top: 16rpx;
}

.reschedule-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff8f3;
}

.compact-picker,
.compact-input {
  min-height: 72rpx;
  font-size: 24rpx;
}

.audit-button {
  margin-top: 14rpx;
}

.audit-list {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #fff8f3;
}

.audit-row {
  padding: 12rpx 0;
  border-top: 1rpx solid #f0e2dc;
}

.audit-row:first-child {
  border-top: 0;
}

.audit-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #3d2d28;
}

.audit-desc {
  margin-top: 8rpx;
  color: #6d4f43;
  font-size: 22rpx;
  line-height: 1.5;
}

.empty-subcard {
  color: #8a665a;
  font-size: 24rpx;
}

.staff-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
  background: #fffaf8;
}

.staff-page button::after {
  border: 0;
}

.staff-navigation {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.staff-navigation-two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.staff-navigation-tab {
  display: flex;
  min-width: 0;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #fff0eb;
  color: #e8856c;
  font-size: 26rpx;
  line-height: 32rpx;
  text-align: center;
}

.staff-navigation-tab-active {
  background: #e8856c;
  color: #ffffff;
  font-weight: 500;
}

.management-entry {
  display: flex;
  min-height: 104rpx;
  box-sizing: border-box;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
  padding: 22rpx 28rpx;
  border: 2rpx solid #f5ddd5;
  border-radius: 28rpx;
  background: #fff8f5;
}

.management-entry-copy {
  min-width: 0;
  flex: 1;
}

.management-entry-title {
  color: #3d2c2c;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.management-entry-desc {
  margin-top: 4rpx;
  color: #9b7e75;
  font-size: 22rpx;
  line-height: 32rpx;
}

.management-entry-arrow {
  flex: 0 0 auto;
  color: #d77864;
  font-size: 42rpx;
  line-height: 48rpx;
}

.staff-page .card {
  box-sizing: border-box;
  border-radius: 32rpx;
  padding: 40rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.05);
}

.staff-page .identity-card,
.staff-page .dev-card,
.staff-page .state-card {
  margin-top: 0;
  margin-bottom: 28rpx;
}

.staff-page .identity-label {
  color: #6b5555;
  font-size: 28rpx;
  line-height: 34rpx;
}

.staff-page .identity-value {
  margin-top: 10rpx;
  color: #3d2c2c;
  font-size: 26rpx;
  line-height: 34rpx;
  word-break: break-all;
}

.staff-page .helper-text,
.staff-page .section-desc,
.staff-page .state-desc {
  color: #a89999;
  font-size: 24rpx;
  line-height: 34rpx;
}

.staff-page .dev-card {
  border: 2rpx solid #fff0eb;
  background: #fff8f5;
  box-shadow: none;
}

.staff-page .button-primary {
  background: #e8856c;
  color: #ffffff;
}

.staff-page .button-secondary {
  background: #fff6f2;
  color: #e8856c;
}

.staff-page .section-title {
  color: #3d2c2c;
  font-size: 32rpx;
  line-height: 42rpx;
}

.staff-appointments-page .review-notice-card {
  display: none;
}

.staff-appointments-page .summary-card {
  margin-top: 28rpx;
  padding: 32rpx 24rpx;
}

.staff-appointments-page .summary-grid-quad {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20rpx;
}

.staff-appointments-page .summary-item {
  min-width: 0;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff8f5;
}

.staff-appointments-page .summary-label {
  color: #8b7070;
  font-size: 24rpx;
  line-height: 30rpx;
}

.staff-appointments-page .summary-value {
  margin-top: 8rpx;
  color: #e8856c;
  font-size: 50rpx;
  line-height: 56rpx;
}

.summary-caption {
  margin-top: 4rpx;
  color: #a89999;
  font-size: 22rpx;
  line-height: 28rpx;
}

.staff-appointments-page .workbench-card,
.staff-appointments-page .filter-card,
.staff-appointments-page .calendar-card,
.staff-appointments-page .detail-card,
.staff-appointments-page .booking-card {
  border-radius: 32rpx;
}

.staff-appointments-page .workbench-panel,
.staff-appointments-page .day-detail-item,
.staff-appointments-page .reschedule-box,
.staff-appointments-page .audit-list {
  border-radius: 24rpx;
  background: #fff8f5;
}

.staff-appointments-page .booking-card {
  margin-top: 28rpx;
  padding: 40rpx;
}

.staff-appointments-page .booking-header {
  gap: 20rpx;
}

.staff-appointments-page .booking-title,
.staff-appointments-page .day-detail-slot {
  color: #3d2c2c;
}

.staff-appointments-page .status-pill {
  min-width: 100rpx;
  padding: 10rpx 16rpx;
  border-radius: 26rpx;
  font-size: 22rpx;
  line-height: 28rpx;
  text-align: center;
}

.staff-appointments-page .detail-filter-chip {
  border-radius: 24rpx;
  background: #fff0eb;
  color: #e8856c;
  box-shadow: none;
}

.staff-appointments-page .detail-filter-chip-active {
  border-color: #e8856c;
  background: #e8856c;
  color: #ffffff;
}
