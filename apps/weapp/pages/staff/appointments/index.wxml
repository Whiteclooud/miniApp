<view class="container">
  <view class="card identity-card">
    <view class="identity-label">店员身份主键</view>
    <view class="identity-value">{{staffIdentity.openId || staffIdentity.label}}</view>
    <view class="helper-text">{{staffIdentity.sourceText}}</view>
  </view>

  <view wx:if="{{staffIdentity.isDevelopEnv}}" class="card dev-card">
    <view class="identity-label">开发环境模拟店员 OpenID</view>
    <input class="field-input" value="{{staffOpenIdInput}}" bindinput="onStaffOpenIdInput" placeholder="填写店员 mock OpenID，便于联调 staff 接口" />
    <view class="action-row">
      <button class="button-primary compact-button" bindtap="applyStaffOpenId">保存并查询</button>
      <button class="button-secondary compact-button" bindtap="generateStaffOpenId">生成模拟 OpenID</button>
    </view>
    <button class="button-ghost compact-button button-row-spacer" bindtap="clearStaffOpenId">清空店员 OpenID</button>
  </view>

  <view class="card nav-card">
    <view class="nav-title">店员工作台</view>
    <view class="action-row">
      <button class="button-secondary compact-button" bindtap="goRules">预约规则</button>
      <button class="button-primary compact-button">预约列表</button>
    </view>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="card state-card">
    <view class="state-title">店员预约列表加载中</view>
    <view class="state-desc">正在通过 X-Staff-OpenId 获取预约列表，请稍候。</view>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="card state-card">
    <view class="state-title">店员预约列表加载失败</view>
    <view class="state-desc">{{stateMessage || '预约列表接口未跑通时，会在这里显式提示。'}}</view>
    <button class="button-secondary" bindtap="loadData">重新加载</button>
  </view>

  <view wx:elif="{{pageState === 'unauthorized'}}" class="card state-card">
    <view class="state-title">店员身份不可用</view>
    <view class="state-desc">{{stateMessage || '缺少店员 OpenID，当前不能继续查询店员页。'}}</view>
    <button class="button-secondary" bindtap="loadData">重新检查</button>
  </view>

  <view wx:elif="{{pageState === 'empty'}}" class="card state-card">
    <view class="state-title">暂无门店预约</view>
    <view class="state-desc">{{stateMessage || 'staff/appointments 接口已返回，但当前没有预约数据。'}}</view>
    <button class="button-secondary" bindtap="loadData">重新加载</button>
  </view>

  <block wx:else>
    <view class="section-title">店员预约总览</view>
    <view class="section-desc">仅供店员查看；列表获取与 review 审核动作都会走固定 staff 契约，并对 unauthorized / error / empty 给出可见反馈。</view>
    <view class="card summary-card">
      <view class="summary-grid">
        <view class="summary-item">
          <view class="summary-label">预约总数</view>
          <view class="summary-value">{{summary.total}}</view>
        </view>
        <view class="summary-item">
          <view class="summary-label">待审核</view>
          <view class="summary-value">{{summary.pending}}</view>
        </view>
      </view>
    </view>
    <view wx:if="{{reviewMessage}}" class="inline-error">{{reviewMessage}}</view>
    <block wx:for="{{appointments}}" wx:key="id">
      <view class="card booking-card">
        <view class="booking-header">
          <view class="booking-title">{{item.customerName}}</view>
          <view class="status-pill">{{item.statusText}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">预约时间</view>
          <view class="info-value">{{item.date}} {{item.timeSlot}}</view>
        </view>
        <view class="info-row">
          <view class="info-label">联系电话</view>
          <view class="info-value">{{item.phone}}</view>
        </view>
        <view wx:if="{{item.note}}" class="info-row">
          <view class="info-label">备注</view>
          <view class="info-value">{{item.note}}</view>
        </view>
        <view wx:if="{{item.createdAtText}}" class="info-row">
          <view class="info-label">提交时间</view>
          <view class="info-value">{{item.createdAtText}}</view>
        </view>
        <view wx:if="{{item.canReview}}" class="review-action-row">
          <view class="helper-text">待审核预约可直接调用 `/api/v1/staff/appointments/:id/review` 完成审核。</view>
          <view class="action-row">
            <button
              class="button-primary compact-button"
              bindtap="reviewAppointment"
              data-id="{{item.id}}"
              data-action="approve"
              loading="{{reviewStateMap[item.id] === 'approving'}}"
              disabled="{{reviewStateMap[item.id] === 'approving' || reviewStateMap[item.id] === 'rejecting'}}"
            >通过预约</button>
            <button
              class="button-secondary compact-button"
              bindtap="reviewAppointment"
              data-id="{{item.id}}"
              data-action="reject"
              loading="{{reviewStateMap[item.id] === 'rejecting'}}"
              disabled="{{reviewStateMap[item.id] === 'approving' || reviewStateMap[item.id] === 'rejecting'}}"
            >驳回预约</button>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>
