<view class="container staff-page staff-appointments-page">
  <view class="staff-navigation">
    <view class="staff-navigation-tab staff-navigation-tab-active">预约总览</view>
    <view class="staff-navigation-tab" bindtap="goRules">预约规则</view>
    <view class="staff-navigation-tab" bindtap="goGallery">返图管理</view>
  </view>

  <view wx:if="{{!staffIdentity.canUse}}" class="card identity-card">
    <view class="identity-label">店员身份主键</view>
    <view class="identity-value">{{staffIdentity.openId || staffIdentity.label}}</view>
    <view class="helper-text">{{staffIdentity.sourceText}}</view>
  </view>

  <view wx:if="{{staffIdentity.isDevelopEnv}}" class="card dev-card">
    <view class="identity-label">开发环境模拟店员 OpenID</view>
    <input class="field-input" value="{{staffOpenIdInput}}" bindinput="onStaffOpenIdInput" placeholder="填写店员 mock OpenID，便于联调 staff 接口" />
    <view class="action-row">
      <button class="button-primary compact-button" bindtap="applyStaffOpenId">保存并查询</button>
      <button class="button-secondary compact-button" bindtap="generateStaffOpenId">生成模拟 OpenID</button>
    </view>
    <button class="button-ghost compact-button button-row-spacer" bindtap="clearStaffOpenId">清空店员 OpenID</button>
  </view>

  <view wx:if="{{pageState === 'loading'}}" class="card state-card">
    <view class="state-title">店员预约列表加载中</view>
    <view class="state-desc">正在通过 X-Staff-OpenId 获取默认未传 status 的预约列表，用于月历聚合，请稍候。</view>
  </view>

  <view wx:elif="{{pageState === 'error'}}" class="card state-card">
    <view class="state-title">店员预约列表加载失败</view>
    <view class="state-desc">{{stateMessage || '预约列表接口未跑通时，会在这里显式提示。'}}</view>
    <button class="button-secondary" bindtap="loadData">重新加载</button>
  </view>

  <view wx:elif="{{pageState === 'unauthorized'}}" class="card state-card">
    <view class="state-title">店员身份不可用</view>
    <view class="state-desc">{{stateMessage || '缺少店员 OpenID，当前不能继续查询店员页。'}}</view>
    <button class="button-secondary" bindtap="loadData">重新检查</button>
  </view>

  <block wx:else>
    <view class="section-title">预约总览</view>
    <view class="section-desc">查看待审核、今日到店和已通过预约，继续在下方处理完整的预约列表。</view>
    <view class="card review-notice-card">
      <view class="review-notice-title">审核口径</view>
      <view class="review-notice-text">当前支持对已审核结果再次修改，系统以最新审核结果为准；改回通过时仍会校验时段冲突。</view>
    </view>

    <view class="card summary-card">
      <view class="summary-grid summary-grid-quad">
        <view class="summary-item">
          <view class="summary-label">待处理</view>
          <view class="summary-value">{{summary.pending}}</view>
          <view class="summary-caption">需要审核</view>
        </view>
        <view class="summary-item">
          <view class="summary-label">今日到店</view>
          <view class="summary-value">{{workbenchSummary.today}}</view>
          <view class="summary-caption">已安排 {{workbenchSummary.todayApproved}}</view>
        </view>
        <view class="summary-item">
          <view class="summary-label">已通过</view>
          <view class="summary-value">{{summary.approved}}</view>
          <view class="summary-caption">当前累计</view>
        </view>
      </view>
      <view wx:if="{{stateMessage}}" class="helper-text summary-helper">{{stateMessage}}</view>
    </view>

    <view class="card workbench-card">
      <view class="section-subtitle">今日 / 明日工作台</view>
      <view class="workbench-grid">
        <view class="workbench-panel">
          <view class="summary-label">今日预约</view>
          <view class="summary-value">{{workbenchSummary.today}}</view>
          <view class="helper-text">已通过 {{workbenchSummary.todayApproved}}</view>
        </view>
        <view class="workbench-panel">
          <view class="summary-label">明日预约</view>
          <view class="summary-value">{{workbenchSummary.tomorrow}}</view>
          <view class="helper-text">已通过 {{workbenchSummary.tomorrowApproved}}</view>
        </view>
      </view>
      <view wx:if="{{todayAppointments.length}}" class="mini-list">
        <view wx:for="{{todayAppointments}}" wx:key="id" class="mini-list-row">{{item.timeSlot}} · {{item.customerName}} · {{item.statusText}}</view>
      </view>
    </view>

    <view class="card filter-card">
      <view class="section-subtitle">搜索与筛选</view>
      <input class="field-input" value="{{searchKeyword}}" bindinput="onSearchKeywordInput" placeholder="顾客姓名 / 手机号 / OpenID" />
      <view class="filter-grid">
        <picker mode="date" value="{{searchDate}}" bindchange="onSearchDateChange">
          <view class="picker-trigger">{{searchDate || '选择日期'}}</view>
        </picker>
        <picker mode="selector" range="{{statusPickerOptions}}" range-key="label" value="{{statusPickerIndex}}" bindchange="onSearchStatusChange">
          <view class="picker-trigger">{{statusPickerOptions[statusPickerIndex].label}}</view>
        </picker>
      </view>
      <view class="action-row action-row-wrap">
        <button class="button-primary compact-button" bindtap="runSearchFilters">筛选预约</button>
        <button class="button-secondary compact-button" bindtap="clearSearchFilters">清空筛选</button>
      </view>
    </view>

    <view class="card calendar-card">
      <view class="calendar-header">
        <button class="calendar-switch" data-delta="-1" bindtap="changeMonth">上月</button>
        <view class="calendar-title">{{monthLabel}}</view>
        <button class="calendar-switch" data-delta="1" bindtap="changeMonth">下月</button>
      </view>
      <button class="button-secondary compact-button today-button" bindtap="resetToCurrentMonth">回到本月</button>
      <view class="week-label-row">
        <view wx:for="{{weekLabels}}" wx:key="*this" class="week-label">{{item}}</view>
      </view>
      <view wx:for="{{calendarWeeks}}" wx:key="index" class="calendar-week">
        <view wx:for="{{item}}" wx:key="key" class="calendar-cell {{item.isCurrentMonth ? '' : 'calendar-cell-muted'}} {{item.isSelected ? 'calendar-cell-selected' : ''}}" data-date="{{item.date}}" bindtap="onCalendarDayTap">
          <view class="calendar-day-row">
            <text class="calendar-day-number {{item.isToday ? 'calendar-day-today' : ''}}">{{item.dayNumber}}</text>
            <text wx:if="{{item.total}}" class="calendar-count">{{item.total}}</text>
          </view>
          <view wx:if="{{item.hasItems}}" class="calendar-badges">
            <text wx:if="{{item.pendingText}}" class="calendar-badge pending">{{item.pendingText}}</text>
            <text wx:if="{{item.approvedText}}" class="calendar-badge approved">{{item.approvedText}}</text>
            <text wx:if="{{item.rejectedText}}" class="calendar-badge rejected">{{item.rejectedText}}</text>
          </view>
          <view wx:if="{{item.customerPreviewNames.length}}" class="calendar-customers">
            <text wx:for="{{item.customerPreviewNames}}" wx:key="*this" class="calendar-customer">{{item}}</text>
            <text wx:if="{{item.extraCustomerCount}}" class="calendar-customer more">+{{item.extraCustomerCount}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="card detail-card">
      <view class="detail-title">{{selectedDateMeta.label}}</view>
      <view class="helper-text">{{selectedDateMeta.totalText}}</view>
      <view wx:if="{{dayAppointments.length}}" class="day-detail-list">
        <view wx:for="{{dayAppointments}}" wx:key="id" class="day-detail-item">
          <view class="day-detail-header">
            <view class="day-detail-slot">{{item.timeSlot}}</view>
            <view class="status-pill {{item.status}}">{{item.statusText}}</view>
          </view>
          <view class="day-detail-meta">{{item.customerName}}<text wx:if="{{item.phone && item.phone !== '未填写'}}"> · {{item.phone}}</text></view>
          <view wx:if="{{item.note}}" class="day-detail-note">备注：{{item.note}}</view>
          <view wx:if="{{item.reviewNote}}" class="day-detail-note">审核说明：{{item.reviewNote}}</view>
          <scroll-view wx:if="{{item.referenceImageUrls.length}}" class="appointment-reference-scroll" scroll-x="true" enable-flex="true">
            <view class="appointment-reference-row">
              <image
                wx:for="{{item.referenceImageUrls}}"
                wx:for-item="imageUrl"
                wx:key="*this"
                class="appointment-reference-image"
                mode="aspectFill"
                src="{{imageUrl}}"
                data-id="{{item.id}}"
                data-url="{{imageUrl}}"
                bindtap="previewReferenceImage"
              />
            </view>
          </scroll-view>
        </view>
      </view>
      <view wx:else class="helper-text">选中日期后，会在这里按时间段展示顾客信息与预约状态。</view>
    </view>

    <view wx:if="{{reviewMessage}}" class="inline-error">{{reviewMessage}}</view>

    <view class="section-title">预约明细列表</view>
    <view class="section-desc">{{detailSectionDesc}}</view>
    <scroll-view class="detail-filter-scroll" scroll-x="true" show-scrollbar="{{false}}">
      <view class="detail-filter-row">
        <block wx:for="{{detailFilters}}" wx:key="key">
          <view class="detail-filter-chip {{item.isActive ? 'detail-filter-chip-active' : ''}}" bindtap="onDetailFilterTap" data-value="{{item.key}}">
            <text class="detail-filter-label">{{item.label}}</text>
            <text class="detail-filter-count">{{item.count}}</text>
          </view>
        </block>
      </view>
    </scroll-view>

    <view wx:if="{{listState === 'loading'}}" class="card state-card compact-state-card">
      <view class="state-title">正在刷新筛选结果</view>
      <view class="state-desc">已保留月历总览，当前按选中状态重新请求预约明细。</view>
    </view>

    <view wx:if="{{detailListNotice}}" class="{{listState === 'error' ? 'inline-error' : 'helper-text detail-filter-helper'}}">{{detailListNotice}}</view>

    <block wx:if="{{listAppointments.length}}">
      <view wx:for="{{listAppointments}}" wx:key="id" class="card booking-card">
        <view class="booking-header">
          <view class="booking-title">{{item.customerName}}</view>
          <view class="status-pill {{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="info-row"><view class="info-label">预约时间</view><view class="info-value">{{item.date}} {{item.timeSlot}}</view></view>
        <view class="info-row"><view class="info-label">联系电话</view><view class="info-value">{{item.phone}}</view></view>
        <view wx:if="{{item.note}}" class="info-row"><view class="info-label">备注</view><view class="info-value">{{item.note}}</view></view>
        <view wx:if="{{item.referenceImageUrls.length}}" class="appointment-reference-block">
          <view class="info-label">参考图</view>
          <scroll-view class="appointment-reference-scroll" scroll-x="true" enable-flex="true">
            <view class="appointment-reference-row">
              <image
                wx:for="{{item.referenceImageUrls}}"
                wx:for-item="imageUrl"
                wx:key="*this"
                class="appointment-reference-image"
                mode="aspectFill"
                src="{{imageUrl}}"
                data-id="{{item.id}}"
                data-url="{{imageUrl}}"
                bindtap="previewReferenceImage"
              />
            </view>
          </scroll-view>
        </view>
        <view wx:if="{{item.createdAtText}}" class="info-row"><view class="info-label">提交时间</view><view class="info-value">{{item.createdAtText}}</view></view>
        <view wx:if="{{item.reviewedAtText}}" class="info-row"><view class="info-label">审核时间</view><view class="info-value">{{item.reviewedAtText}}</view></view>
        <view wx:if="{{item.reviewNote}}" class="info-row"><view class="info-label">审核说明</view><view class="info-value">{{item.reviewNote}}</view></view>
        <view wx:if="{{item.canReview}}" class="review-action-row">
          <view class="helper-text">{{item.reviewHint}}</view>
          <view class="action-row action-row-wrap">
            <button wx:if="{{item.showApproveAction}}" class="button-primary compact-button" bindtap="reviewAppointment" data-id="{{item.id}}" data-action="approve" loading="{{reviewStateMap[item.id] === 'approving'}}" disabled="{{reviewStateMap[item.id] === 'approving' || reviewStateMap[item.id] === 'rejecting'}}">{{item.approveActionText}}</button>
            <button wx:if="{{item.showRejectAction}}" class="button-secondary compact-button" bindtap="reviewAppointment" data-id="{{item.id}}" data-action="reject" loading="{{reviewStateMap[item.id] === 'rejecting'}}" disabled="{{reviewStateMap[item.id] === 'approving' || reviewStateMap[item.id] === 'rejecting'}}">{{item.rejectActionText}}</button>
            <button wx:if="{{item.showCancelAction}}" class="button-secondary compact-button" bindtap="reviewAppointment" data-id="{{item.id}}" data-action="cancel" loading="{{reviewStateMap[item.id] === 'cancelling'}}">{{item.cancelActionText}}</button>
            <button wx:if="{{item.showCompleteAction}}" class="button-secondary compact-button" bindtap="reviewAppointment" data-id="{{item.id}}" data-action="complete" loading="{{reviewStateMap[item.id] === 'completing'}}">{{item.completeActionText}}</button>
            <button wx:if="{{item.showNoShowAction}}" class="button-secondary compact-button" bindtap="reviewAppointment" data-id="{{item.id}}" data-action="no_show" loading="{{reviewStateMap[item.id] === 'no_showing'}}">{{item.noShowActionText}}</button>
          </view>
          <view class="reschedule-box">
            <picker mode="date" value="{{rescheduleDraftMap[item.id].date || item.rescheduleDate}}" data-id="{{item.id}}" bindchange="onRescheduleDateChange">
              <view class="picker-trigger compact-picker">{{rescheduleDraftMap[item.id].date || item.rescheduleDate}}</view>
            </picker>
            <input class="field-input compact-input" value="{{rescheduleDraftMap[item.id].timeSlot || item.rescheduleTimeSlot}}" data-id="{{item.id}}" bindinput="onRescheduleSlotInput" placeholder="10:00-11:00" />
            <button class="button-secondary compact-button" bindtap="rescheduleAppointment" data-id="{{item.id}}" data-date="{{item.date}}" data-time-slot="{{item.timeSlot}}" loading="{{reviewStateMap[item.id] === 'rescheduling'}}">协助改期</button>
          </view>
          <button class="button-ghost compact-button audit-button" bindtap="toggleAuditLogs" data-id="{{item.id}}" loading="{{auditStateMap[item.id] === 'loading'}}">操作日志</button>
          <view wx:if="{{auditLogsMap[item.id]}}" class="audit-list">
            <view wx:for="{{auditLogsMap[item.id]}}" wx:key="id" class="audit-row">
              <view class="audit-title">{{item.action}} · {{item.createdAtText}}</view>
              <view class="audit-desc">{{item.fromStatusText || '-'}} → {{item.toStatusText || '-'}} · {{item.fromDate || '-'}} {{item.fromTimeSlot || ''}} → {{item.toDate || '-'}} {{item.toTimeSlot || ''}}</view>
              <view wx:if="{{item.note}}" class="audit-desc">{{item.note}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>
    <view wx:else class="card empty-subcard">{{detailEmptyText}}</view>
  </block>
</view>
