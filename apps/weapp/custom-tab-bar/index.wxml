<view class="tabbar">
  <view
    class="tabbar-item tabbar-home {{selected === 'pages/home/index' ? 'is-active' : ''}}"
    data-path="pages/home/index"
    bindtap="onTabTap"
  >首页</view>
  <view
    class="tabbar-item tabbar-my {{selected === 'pages/my/index' ? 'is-active' : ''}}"
    data-path="pages/my/index"
    bindtap="onTabTap"
  >我的</view>
</view>
